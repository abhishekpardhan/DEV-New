* Description		:		Controller class for JourneyGeolocation Lightning Component to get the current latitue/Longitude and time information and updation them on CheckIn/CheckOut Fields
* Updated By       :       Shubham Girdhar
* Created Date     :       
* Release          :       17th july, 2019
* Last Modified on :       9th july, 2019
* Jira Ticket      :       https://safexpress.atlassian.net/browse/SD-409
-->
<apex:page showHeader="false" standardController="Event__c" standardStylesheets="false" extensions="EventGeolocation" sidebar="false"  docType="html-5.0">
    
    
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
        <head>
            <meta charset="utf-8" />
            <meta http-equiv="x-ua-compatible" content="ie=edge" />
            <title>SLDS ResponsiveDesign Visualforce Page in Salesforce Mobile</title>
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            
            <!-- Import the Design System style sheet -->
            <apex:slds />
        </head>
        <body>
            <c:warningMessage /><br/>
            <c:ErrorMessage />
            <c:SuccessMessage />
            <c:Spinner />
            
            <!--------------GPS Activation alert added on 9th,July 2019 by Shubham Girdhar------------------------->    
            <h1 style="color:red; font-size:20px; text-align:center "> 
                NOTE: <br/> For CheckIn/Checkout,Device GPS must be Activated
            </h1> 
            <!----------------------------------------------------------------------------------------------------->
        </body>
    </html>
    <script type='text/javascript' src='/canvas/sdk/js/publisher.js'></script>
    <script> 
        Sfdc.canvas.publisher.subscribe({name: "publisher.showPanel", 
                                         onData:function(e) {
                                             // Sfdc.canvas.publisher.publish({ name : "publisher.close", payload : { refresh:"true" }});
                                         }});
    </script>
    <script>
    window.onload = function(){ 
        var startPos;
        var lat;
        var lng;
        var acc; 
        
        var geoSuccess = function(position) {          
            startPos = position;
            lat = startPos.coords.latitude;
            lng = startPos.coords.longitude;
            acc = startPos.coords.accuracy;
            var staticLabel = {!$Label.Check_In_Accuracy};            
            
            Visualforce.remoting.Manager.invokeAction( '{!$RemoteAction.EventGeolocation.eventTaskCheck}',
                '{!eventId}',
                function(result, event){
                    document.getElementById("spinner").style.display = 'none';

                    if(result=='True'){
                     
                      document.getElementById("toastWarning").style.display = "block";
                      document.getElementById("warningMsg").innerHTML ='Alert: Please take action if any General/CRP/Onboarding task is in Open Status.' ;
                      document.getElementById("toastSuccess").style.display = 'none';
                      setTimeout(closePopup, 4000); 
                        
                     }
                    else{
                    Istaskcomplete=false;
                    }
                });
             Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.EventGeolocation.eventLocation}',
                '{!eventId}', lat, lng,'checkin', acc,
                function(result, event) {
                    //alert('event '+event.status);
                   
                    if (event.status) {
                        document.getElementById("spinner").style.display = 'none';
                        
                        if(result == 'You are not able to checkIn/checkout this Event.' || result == 'Not possible as Event is Cancelled.' || result == 'Current Event is already Check In.' ||  result == 'Checkin Date Should be same as start date.' || result == 'Please create journey record as you want to claim this Event.' || result.includes('PLease checkout last Event :') || result == 'Journey is already completed.Please ask administrator to Re-open the journey.' || result == 'Please first checkIn related Journey.' || result.includes('Exception')){
                            document.getElementById("toastSuccess").style.display = 'none';
                            document.getElementById("errorMsg").innerHTML ='Error : '+result ;
                            document.getElementById("ToastError").style.display = "block";
                            setTimeout(closePopup, 4000);
                        } else{
                            if(acc > staticLabel){
                                document.getElementById("toastWarning").style.display = "block";
                           
                                document.getElementById("warningMsg").innerHTML += '<br/>Warning : Location accuracy is low. Please move to an open area.' ;
                                //document.getElementById("warningMsg").innerHTML += '<br/><center>Checkin Successful<center>';
                                document.getElementById("toastSuccess").style.display = 'none';
                                                                                                                             
                            }
                            document.getElementById("ToastError").style.display = "none";
                            document.getElementById("successMsg").innerHTML ='Success : Check In Completed' ;
                            document.getElementById("toastSuccess").style.display = 'block';  
                            setTimeout(closePopup, 4000);
                        }
                    }
                });
        };
        var geoError = function(){
            document.getElementById("spinner").style.display = 'none';
            document.getElementById("toastSuccess").style.display = 'none';
            // Error note change from 'Geolocation not supported' to 'Please Reload, Taking too much time to get Geolocation.' by Shubham Girdhar on 9th july 2019
            document.getElementById("errorMsg").innerHTML ='Please Reload, Taking too much time to get Geolocation.' ;
            document.getElementById("ToastError").style.display = "block";
            setTimeout(closePopup, 4000);
        };
        var geooptions = {
            enableHighAccuracy: true, 
            maximumAge        : 15000, 
            timeout           : 15000
        };
        
        navigator.geolocation.getCurrentPosition(geoSuccess, geoError ,geooptions); 
        //toastEvent.fire();
        function closePopup(){
            Sfdc.canvas.publisher.publish({ name : "publisher.close", payload : { refresh:"true" }});
        }
    }
    </script>
</apex:page>