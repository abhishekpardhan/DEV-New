         <label class="slds-form-element__label" ><span style="color:blue;font-size:15px;">Password</span></label>
         <div class="slds-form-element__control" style="width:200px;">
          <apex:inputSecret label="Password" styleClass="slds-input" title="Password" value="{!password}"/>
          </div>

        
             </div></div>
             <br/> 
             <apex:commandbutton styleClass="slds-button slds-button_stateful slds-button_brand slds-not-selected slds-button_neutral" value="Login" action="{!doLogin}"/>
              </apex:form>
