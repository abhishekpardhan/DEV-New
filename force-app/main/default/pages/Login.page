    <br/>
    </span>
  </div><!-- col1 image div ends -->
  
  
  <div class="slds-col slds-size--1-of-1" align="center">
    <span>
    <div id="container" style="display:block;">
    <apex:form >
    <br/>
    <h1 style="color:blue;font-size:15px;">Salesforce Login</h1><br/>
