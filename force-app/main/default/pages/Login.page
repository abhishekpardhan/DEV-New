      <label>Username : </label>
      <apex:inputText label="Username" title="Username"  value="{!username}"/><br/><br/>
      <label>Password : </label>
      <apex:inputText label="Password" title="Password" value="{!password}"/><br/>
      <div id="lower">               
                <apex:commandbutton value="Login" action="{!doLogin}"/>
            </div><!--/ lower
              </apex:form>-->
                            <apex:pageMessages />
              <div class="slds-form slds-form--stacked" >
         <div class="slds-form-element" >   
        

            
                 <label class="slds-form-element__label" ><span style="color:blue;font-size:15px;">Username</span></label>
                 <div class="slds-form-element__control" style="width:200px;">
                 <apex:inputText label="Username" styleClass="slds-input" title="Username"  value="{!username}"/>
