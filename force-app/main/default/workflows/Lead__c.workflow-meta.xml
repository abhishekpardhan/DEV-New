    <rules>
        <fullName>Email to FTL after lead drop as FTL</fullName>
        <actions>
            <name>Send_Email_to_FTL_after_lead_droppes_as_FTL</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <formula>AND(ISCHANGED( Approval_Status__c ),ISPICKVAL(Approval_Status__c,  &apos;Approved&apos;),ISPICKVAL(Status__c,&apos;Dropped&apos;),ISPICKVAL(Lead_Drop_Reason__c,&apos;FTL Customer&apos;))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Lead Assigned Date</fullName>
        <actions>
            <name>Field_Assigned_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>OR(ISNEW(),ISCHANGED(OwnerId))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Lead Name Capital</fullName>
        <actions>
            <name>Lead_Name_Capital</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Lead__c.Name</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Lead Status Active</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Lead__c.Passive_Till__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Lead_Status_Active</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Lead__c.Passive_Till__c</offsetFromField>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
