<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Send_email_on_BDM_change</fullName>
        <ccEmails>megha.kumar@safexpress.com</ccEmails>
        <ccEmails>poonam.verma@safexpress.com</ccEmails>
        <description>Send email on BDM change</description>
        <protected>false</protected>
        <recipients>
            <field>BDM__c</field>
            <type>userLookup</type>
        </recipients>
        <senderAddress>noreply@safexpress.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/BDM_change_on_Account_team</template>
    </alerts>
    <fieldUpdates>
        <fullName>Update_Composite_key</fullName>
        <field>Composite_key__c</field>
        <formula>CASESAFEID(Account__c ) +&apos;-&apos;+  CASESAFEID(BDM__c)</formula>
        <name>Update Composite key</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Update Account Team Key</fullName>
        <actions>
            <name>Update_Composite_key</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>true</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
