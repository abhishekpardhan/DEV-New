    </rules>
    <rules>
        <fullName>Opportunity Name Capital</fullName>
        <actions>
            <name>Opportunity_Name_Capital</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity__c.Name</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Opportunity Status Active</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity__c.Passive_Till__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
