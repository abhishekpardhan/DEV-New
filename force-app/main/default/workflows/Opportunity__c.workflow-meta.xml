    <rules>
        <fullName>Closed Date update</fullName>
        <actions>
            <name>Closed_date_update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND( OR(ISNEW(), ISCHANGED(Stage__c)) ,OR(ISPICKVAL(Stage__c,&apos;Closed Lost&apos;) ,ISPICKVAL(Stage__c,&apos;Closed Won&apos;)))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
