<?xml version="1.0" encoding="UTF-8"?>
<AutoResponseRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <autoResponseRule>
        <fullName>Case Auto response</fullName>
        <active>true</active>
        <ruleEntry>
            <criteriaItems>
                <field>Case.Status</field>
                <operation>equals</operation>
                <value>New,Created</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.SuppliedEmail</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Case_Type__c</field>
                <operation>equals</operation>
                <value>Booking Request</value>
            </criteriaItems>
            <notifyCcRecipients>true</notifyCcRecipients>
            <senderEmail>noreply@safexpress.com</senderEmail>
            <senderName>Safexpress Support</senderName>
            <template>unfiled$public/SUPPORTWebtoCaseemailresponseSAMPLE</template>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Case.Status</field>
                <operation>equals</operation>
                <value>New,Created</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>notEqual</operation>
                <value>Booking Request</value>
            </criteriaItems>
            <notifyCcRecipients>true</notifyCcRecipients>
            <senderEmail>noreply@safexpress.com</senderEmail>
            <senderName>Safexpress Support case reply</senderName>
            <template>unfiled$public/Email_Case_Auto_response_rule</template>
        </ruleEntry>
    </autoResponseRule>
</AutoResponseRules>
