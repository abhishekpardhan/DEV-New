    "preheader" : "{!$Expression.First_Name_1}, thank you for trusting Safexpress with every journey. Happy Diwali!",
    "rawHtml" : "<!DOCTYPE html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no, url=no\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Shubh Deepavali from Safexpress</title>\n<!--[if mso]>\n<noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>\n<style>\n  table, td, div, p, a, span { font-family: Arial, Helvetica, sans-serif !important; }\n  .serif { font-family: Georgia, 'Times New Roman', serif !important; }\n</style>\n<![endif]-->\n<style type=\"text/css\">\n  body { margin:0 !important; padding:0 !important; width:100% !important; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\n  table, td { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }\n  img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; display:block; }\n  a { text-decoration:none; }\n  a[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; font-size:inherit !important; font-family:inherit !important; font-weight:inherit !important; line-height:inherit !important; }\n  u + #body a { color:inherit; text-decoration:none; }\n  #MessageViewBody a { color:inherit; text-decoration:none; }\n\n  @media only screen and (max-width:620px) {\n    .container { width:100% !important; max-width:100% !important; }\n    .px { padding-left:24px !important; padding-right:24px !important; }\n    .hero-pad { padding:20px 24px 30px 24px !important; }\n    .h1 { font-size:26px !important; line-height:34px !important; }\n    .lead { font-size:16px !important; line-height:26px !important; }\n    .col { display:block !important; width:100% !important; max-width:100% !important; padding:0 0 14px 0 !important; box-sizing:border-box; }\n    .card { height:auto !important; }\n    .hide-m { display:none !important; max-height:0 !important; overflow:hidden !important; mso-hide:all !important; }\n    .btn a { display:block !important; }\n    .center-m { text-align:center !important; }\n  }\n</style>\n</head>\n<body id=\"body\" style=\"margin:0; padding:0; background-color:#F4EFE3;\">\n\n<!-- Preheader: set it in MC Next's Preheader field (MC Next strips display:none, so a hidden div here would show up) -->\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F4EFE3;\">\n<tr>\n<td align=\"center\" style=\"padding:12px 8px;\">\n\n<!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" class=\"container\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:600px; max-width:600px; background-color:#FFFFFF;\">\n\n  <!-- ===== HERO ===== -->\n  <tr>\n    <td bgcolor=\"#0B5D2B\" style=\"background-color:#0B5D2B;\">\n      <!--[if mso]>\n      <v:rect xmlns:v=\"urn:schemas-microsoft-com:vml\" fill=\"true\" stroke=\"false\" style=\"width:600px;\">\n        <v:fill type=\"gradient\" color=\"#0B5D2B\" color2=\"#074A24\" angle=\"180\"/>\n        <v:textbox inset=\"0,0,0,0\">\n      <![endif]-->\n      <div style=\"background-color:#0B5D2B; background-image:linear-gradient(180deg,#0B5D2B 0%,#074A24 100%);\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td align=\"center\" class=\"hero-pad\" style=\"padding:26px 48px 38px 48px;\">\n\n              <!-- logo (inside hero = one seamless green block, no row seam) -->\n              <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"text-decoration:none;\">\n        <img src=\"https://www.safexpress.com/assets/images/new-logo-white.png\" width=\"150\" border=\"0\" align=\"middle\" alt=\"SAFEXPRESS\" style=\"vertical-align:middle; width:150px; max-width:150px; height:auto; border:0; outline:none; font-family:Georgia, 'Times New Roman', serif; font-size:26px; line-height:32px; font-weight:bold; letter-spacing:3px; color:#FFFFFF;\">\n      </a>\n\n\n              <!-- diya -->\n              <div style=\"font-size:40px; line-height:48px; padding-top:26px;\">&#129684;</div>\n\n              <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; letter-spacing:4px; font-weight:bold; color:#F2C14E; padding-top:10px; text-transform:uppercase;\">Shubh Deepavali</div>\n\n              <h1 class=\"h1 serif\" style=\"margin:10px 0 0 0; font-family:Georgia, 'Times New Roman', serif; font-size:32px; line-height:40px; font-weight:normal; color:#FFFFFF;\">\n                May every journey be<br>lit with <span style=\"color:#F2C14E; font-style:italic;\">light &amp; prosperity</span>\n              </h1>\n\n            </td>\n          </tr>\n        </table>\n      </div>\n      <!--[if mso]>\n        </v:textbox>\n      </v:rect>\n      <![endif]-->\n    </td>\n  </tr>\n\n  <!-- ===== RANGOLI BORDER ===== -->\n  <tr>\n    <td align=\"center\" style=\"background-color:#F2C14E; padding:7px 0; font-family:Arial, Helvetica, sans-serif; font-size:11px; line-height:12px; letter-spacing:8px; color:#0B5D2B;\">\n      &#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;&#9671;&#9670;\n    </td>\n  </tr>\n\n  <!-- ===== LETTER ===== -->\n  <tr>\n    <td class=\"px\" style=\"padding:44px 48px 12px 48px;\">\n      <!-- PERSONALIZATION: First Name expression from MC Next - keep fallback \"Valued Partner\" set in the builder -->\n      <p style=\"margin:0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#1F2A23;\"><span>Dear&nbsp;</span><span>{!$Expression.First_Name}</span><span>,</span></p>\n      <p style=\"margin:16px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#3D4A42;\">\n        Diwali is a celebration of new beginnings, and every year it reminds us how much your partnership means to us. Your trust powers every truck on the road and every shipment that reaches its destination on time.\n      </p>\n      <p style=\"margin:16px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:26px; color:#3D4A42;\">\n        Through the festive rush and beyond, our network stays with you round the clock, so your business keeps moving while you celebrate.\n      </p>\n    </td>\n  </tr>\n\n  <!-- ===== SERVICE CARDS (3 col, stack on mobile) ===== -->\n  <tr>\n    <td class=\"px\" style=\"padding:24px 42px 8px 42px;\">\n      <!-- 3 equal cards: real table cells, so they never wrap on desktop/Outlook; stack on mobile via .col -->\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; table-layout:fixed;\">\n        <tr>\n          <td class=\"col\" width=\"33.33%\" valign=\"top\" style=\"width:33.33%; padding:0 6px; vertical-align:top;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FBF7EC; border:1px solid #EFE3C2;\">\n              <tr><td class=\"card\" align=\"center\" valign=\"top\" height=\"150\" style=\"height:150px; padding:22px 12px; vertical-align:top;\">\n                <div style=\"font-size:28px; line-height:32px;\">&#128230;</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:20px; font-weight:bold; color:#0B5D2B; padding-top:10px;\">Track Shipment</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:19px; color:#5E6B63; padding-top:6px;\">Live status by Waybill, E-Waybill or Invoice</div>\n              </td></tr>\n            </table>\n          </td>\n          <td class=\"col\" width=\"33.33%\" valign=\"top\" style=\"width:33.33%; padding:0 6px; vertical-align:top;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FBF7EC; border:1px solid #EFE3C2;\">\n              <tr><td class=\"card\" align=\"center\" valign=\"top\" height=\"150\" style=\"height:150px; padding:22px 12px; vertical-align:top;\">\n                <div style=\"font-size:28px; line-height:32px;\">&#128666;</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:20px; font-weight:bold; color:#0B5D2B; padding-top:10px;\">Book Now</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:19px; color:#5E6B63; padding-top:6px;\">Schedule your festive consignments online</div>\n              </td></tr>\n            </table>\n          </td>\n          <td class=\"col\" width=\"33.33%\" valign=\"top\" style=\"width:33.33%; padding:0 6px; vertical-align:top;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FBF7EC; border:1px solid #EFE3C2;\">\n              <tr><td class=\"card\" align=\"center\" valign=\"top\" height=\"150\" style=\"height:150px; padding:22px 12px; vertical-align:top;\">\n                <div style=\"font-size:28px; line-height:32px;\">&#128222;</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:20px; font-weight:bold; color:#0B5D2B; padding-top:10px;\">We're Here</div>\n                <div style=\"font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:19px; color:#5E6B63; padding-top:6px;\">Call 1800 113 113 for any assistance</div>\n              </td></tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ===== CTA BUTTON (bulletproof) ===== -->\n  <tr>\n    <td align=\"center\" class=\"px\" style=\"padding:28px 48px 8px 48px;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" class=\"btn\">\n        <tr>\n          <td align=\"center\" bgcolor=\"#0B5D2B\" style=\"border-radius:4px; background-color:#0B5D2B; padding:15px 40px; border-bottom:3px solid #F2C14E; mso-padding-alt:0;\">\n            <!--[if mso]>\n            <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://www.safexpress.com/\" style=\"height:50px; v-text-anchor:middle; width:260px;\" arcsize=\"8%\" stroke=\"f\" fillcolor=\"#0B5D2B\">\n              <w:anchorlock/>\n              <center style=\"color:#FFFFFF; font-family:Arial, Helvetica, sans-serif; font-size:16px; font-weight:bold;\">Track Your Shipment</center>\n            </v:roundrect>\n            <![endif]-->\n            <!--[if !mso]><!-->\n            <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:bold; color:#FFFFFF; text-decoration:none;\">Track Your Shipment &rarr;</a>\n            <!--<![endif]-->\n          </td>\n        </tr>\n      </table>\n      <p style=\"margin:14px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:20px; color:#7A857E;\">\n        or <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"color:#0B5D2B; text-decoration:underline; font-weight:bold;\">book a new consignment</a>\n      </p>\n    </td>\n  </tr>\n\n  <!-- ===== SIGN OFF ===== -->\n  <tr>\n    <td class=\"px\" style=\"padding:32px 48px 44px 48px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td height=\"1\" style=\"height:1px; line-height:1px; font-size:1px; background-color:#EFE7D4;\">&nbsp;</td></tr>\n      </table>\n      <p class=\"serif\" style=\"margin:28px 0 0 0; font-family:Georgia, 'Times New Roman', serif; font-size:20px; line-height:30px; font-style:italic; color:#0B5D2B; text-align:center;\">\n        Wishing you and your loved ones a joyous, safe and prosperous Diwali.\n      </p>\n      <p style=\"margin:14px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; font-weight:bold; letter-spacing:1px; color:#8A7A52; text-align:center; text-transform:uppercase;\">\n        Team Safexpress\n      </p>\n    </td>\n  </tr>\n\n  <!-- ===== FOOTER ===== -->\n  <tr>\n    <td class=\"px\" style=\"background-color:#042E16; padding:32px 40px; text-align:center;\">\n      <p style=\"margin:0; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:22px; color:#CFE5D6;\">\n        <a href=\"mailto:info@safexpress.com\" style=\"color:#F2C14E; text-decoration:none;\">info@safexpress.com</a>\n        &nbsp;&nbsp;|&nbsp;&nbsp;\n        <a href=\"tel:1800113113\" style=\"color:#F2C14E; text-decoration:none;\">1800 113 113</a>\n      </p>\n      <p style=\"margin:14px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:20px; color:#9DBFA8;\">\n        <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"color:#9DBFA8; text-decoration:underline;\">Website</a>\n        &nbsp;&middot;&nbsp;\n        <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"color:#9DBFA8; text-decoration:underline;\">Track</a>\n        &nbsp;&middot;&nbsp;\n        <a href=\"https://www.safexpress.com/\" target=\"_blank\" style=\"color:#9DBFA8; text-decoration:underline;\">Contact Us</a>\n      </p>\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:20px;\">\n        <tr><td height=\"1\" style=\"height:1px; line-height:1px; font-size:1px; background-color:#1E5634;\">&nbsp;</td></tr>\n      </table>\n      <p style=\"margin:18px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:11px; line-height:18px; color:#7FA38B;\">\n        You are receiving this email because you are associated with Safexpress.<br>\n        <!-- MC Next unsubscribe link: the token goes in href, never as the link text -->\n        <a href=\"{{$link.EmailAddressOptOutUrl}}\" target=\"_blank\" style=\"color:#9DBFA8; text-decoration:underline;\">Unsubscribe</a>\n      </p>\n      <p style=\"margin:10px 0 0 0; font-family:Arial, Helvetica, sans-serif; font-size:11px; line-height:18px; color:#7FA38B;\">\n        {{$organization.Address}}<br>\n        &copy; 2026 Safexpress. All rights reserved.\n      </p>}\n    </td>\n  </tr>\n\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n\n</td>\n</tr>\n</table>\n</body>\n</html>",
