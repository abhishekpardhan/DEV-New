<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Approval_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Pending_from_Claim_Dept</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>AM Approval</label>
        <name>AM_Approval</name>
        <rejectionActions>
            <action>
                <name>Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_claim_dept</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>soumitra.pramanik@safexpress.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(1 OR 3) AND 2</booleanFilter>
            <criteriaItems>
                <field>Case__c.Case_Typee__c</field>
                <operation>equals</operation>
                <value>Credit Note</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case__c.Case_Type__c</field>
                <operation>equals</operation>
                <value>Damage/Shortage Delivery</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case__c.Case_Typee__c</field>
                <operation>equals</operation>
                <value>Commercial Credit Note</value>
            </criteriaItems>
        </entryCriteria>
        <label>Claim Approval</label>
        <name>Claim_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Rejected_by_Claim_Dept</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_to_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case__c.RecordType</field>
            <operation>equals</operation>
            <value>Revenue Management Case</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved By AM</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Total_Waybill_No__c</field>
            <operation>notEqual</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Status__c</field>
            <operation>equals</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Case_Type__c</field>
            <operation>equals</operation>
            <value>Damage/Shortage Delivery</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>update_approval_status</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>New Case Approval Process</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>4</processOrder>
    <recallActions>
        <action>
            <name>Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
