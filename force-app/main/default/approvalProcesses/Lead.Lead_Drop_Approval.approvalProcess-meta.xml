<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Company</field>
        <field>Region__c</field>
        <field>Vertical__c</field>
        <field>Lead_Drop_Reason__c</field>
        <field>Please_Specify__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Lead.Status</field>
            <operation>equals</operation>
            <value>Dropped</value>
        </criteriaItems>
        <criteriaItems>
            <field>Lead.Approval_Status__c</field>
            <operation>notContain</operation>
            <value>Approved,Pending for Approval</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Lead_Approval_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Lead_Status_Dropped</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Drop_Reason_Field_Update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Lead_Approval_Status_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Lead_Status_Active</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Please_Specify_Field_Reset</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Lead_Approval_Status_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Lead Drop Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Drop_Reason_Field_Update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Lead_Approval_Status_Reset</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Lead_Status_Active</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Please_Specify_Field_Reset</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
