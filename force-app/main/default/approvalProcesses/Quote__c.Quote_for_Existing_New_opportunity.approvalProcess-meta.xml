<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Approval_Status__c</field>
        <field>AM__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approve_by_RM</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opportunity_Type_Existing</name>
                <type>Task</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>RM__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Quote__c.RM__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>Opportunity__c.Customer_Type__c</field>
                <operation>equals</operation>
                <value>Existing-New</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>RM</label>
        <name>RM</name>
        <rejectionActions>
            <action>
                <name>RejectedBy_RM</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>update_back_recordtype</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Status11_1</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_CCD</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>sanjay.nair@safexpress.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Quote__c.Approval_Status__c</field>
                <operation>notEqual</operation>
                <value>Approved By CCD</value>
            </criteriaItems>
        </entryCriteria>
        <label>CCD Approval</label>
        <name>CCD_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Recordtype_update</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Rejected_by_CCD</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>status_update</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity__c.Customer_Type__c</field>
            <operation>equals</operation>
            <value>Existing-New</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity__c.Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity__c.Customer_Type__c</field>
            <operation>notEqual</operation>
            <value>New Opportunity,Renewal Opportunity</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Pending_with_Quotation_team2</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>recordtype_change</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>update_recordtype4</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Submit_for_approvals</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_recordtypes</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Quote for Existing-New opportunity</label>
    <processOrder>4</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
