<!-- sldsValidatorIgnore -->
<aura:component implements="force:hasRecordId,lightning:actionOverride,lightning:isUrlAddressable,lightning:hasPageReference" access="global" >
    <aura:attribute name="createCaseId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <lightning:workspaceAPI aura:id="workspace"/>

    <div class="slds-box--border slds-theme--default">
        <lightning:flow aura:id="flowId" onstatuschange="{!c.handleStatusChange}"/>
    </div>
    <div class="blank" style="min-height: 50px !important;"></div>
    
</aura:component>