                                                                <span data-value="{!Jor.Id}"  onclick="{!c.openMap}">
                                                                    <lightning:icon iconName="action:map" size="xx-small"/>
                                                                </span>
                                                            </button>
                                                            <!--<ui:inputCheckbox aura:id="checkbox" label="" change=""/> 
                            -->
                                                        </div>
                                                        </div>
                                                    </aura:set>
                                                    <aura:set attribute="body">
                                                        <!-- <aura:unescapedHtml value=""/>
                                    <br/> -->
