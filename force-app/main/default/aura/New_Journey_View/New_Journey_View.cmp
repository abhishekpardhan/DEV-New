<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId" access="global" controller="BDM_Journey_View_Controller" >
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/> 
    <!--attributes-->
    <aura:attribute name="StartDate" type="Date"/>
    <aura:attribute name="Id" type="id"/>
    <aura:attribute name="EndDate" type="Date"/>
    <aura:attribute name="MaxDate" type="Date"/>
    <aura:attribute name="MinDate" type="Date"/>
    <aura:attribute name="Month" type="Date"/>
    <aura:attribute name="JourneyList" type="List"/>
    <aura:attribute name="myJourneyListNotToBeClaimed" type="List"/>
    <aura:attribute name="myJourneyListToBeSubmitted" type="List"/>
    <aura:attribute name="myJourneyListRejected" type="List"/>
    <aura:attribute name="myJourneyListApproved" type="List"/>
    <aura:attribute name="EventList" type="List"/>
    <aura:attribute name="ExList" type="List"/>
    <aura:attribute name="ActiveId" type="String"/>
    <aura:attribute name="isOpen" type="Boolean" default="false"/>
    <aura:attribute name="ButtonDisable" type="Boolean" default="true"/>
    <aura:attribute name="AuditSectionVisibility" type="Boolean" default="false"/>
    <aura:attribute name="OpenIf" type="Boolean" default="false"/>
    <aura:attribute name="SubmitButton" type="String" default="block"/>
    <!-- <aura:attribute name="mapMarkers" type="object[]"/>
<aura:attribute name="markersTitle" type="String" /> -->
    <aura:attribute name="openNewExpense" type="Boolean" default="false"/>
    <aura:attribute name="ExpenseType" type="List"/>
    <aura:attribute name="TotalJourney" type="Integer"/>
    <aura:attribute name="TotalDistance" type="Decimal"/>
    <aura:attribute name="TotalAmount" type="Decimal"/>
    <aura:attribute name="TotalApprovedAmount" type="Decimal"/>
    <aura:attribute name="TotalEvent" type="Decimal" default="0" />
    <aura:attribute name="mapMarkers" type="Object"/>
    <aura:attribute name="center" type="Object" />
    <aura:attribute name="zoomLevel" type="Integer" />
    <aura:attribute name="markersTitle" type="String" />
    <aura:attribute name="showFooter" type="Boolean" />
    <aura:attribute name="NewExpense" type="Expense_Item__c"/>
    <aura:attribute name="CreateExpense" type="Expense_Item__c[]" default="{
                                                                           sobjectName : 'Expense_Item__c',
                                                                           Amount__c : '', 
                                                                           Bill_Number__c : '',
                                                                           Expense_Type__c : '',
                                                                           If_Others_Please_specify__c : '',
                                                                           Comment__c : '',
                                                                           Name : ''
                                                                           }" />
    <aura:attribute name="JorId" type="String"/>
    <aura:attribute name="parentId" type="Id" />
    <aura:attribute name="number" type="Integer"/> 
    <aura:attribute name="Users" type="List"/>
    <aura:attribute name="SelectedUser" type="Id"/>
    <aura:attribute name="MaxDate1" type="Date"/>
    <aura:attribute name="MinDate1" type="Date"/>
    <aura:attribute name="Month1" type="Date"/>
    <aura:attribute name="JourneyListTeam" type="List"/>
    <aura:attribute name="JourneyListApproved" type="List"/>
    <aura:attribute name="JourneyListRejected" type="List"/>
    <aura:attribute name="JourneyListNotToBeClaimed" type="List"/>
    <aura:attribute name="JourneyListToBeSubmitted" type="List"/>
    <aura:attribute name="Rejection" type="Boolean" default="false"/>
    <aura:attribute name="SelectedUserProfile" type="User"/>
    <aura:attribute name="TotalJourneyTeam" type="Integer"/>
    <aura:attribute name="TotalDistanceTeam" type="Decimal"/>
    <aura:attribute name="TotalAmountTeam" type="Decimal"/>
    <aura:attribute name="TotalApprovedAmountTeam" type="Decimal"/>
    <aura:attribute name="TotalEventTeam" type="Decimal" default="0" />
    <aura:attribute name="RejectedJourney" type="id"/>
    <aura:attribute name="comment" type="String"/>
    <aura:attribute name="MinDateForDay" type="String" />
    <aura:attribute name="MaxDateForDay" type="String" />
    <aura:attribute name="SelectedDate" type="String" />
    <aura:attribute name="DisabledDates" type="List" default="[]"/>
    <aura:attribute name="isLoading" type="Boolean" default="false" />

    <!-- Tabs and Pagination Controls -->
    <aura:attribute name="tab1Records" type="List" default="[]"/>
    <aura:attribute name="tab2Records" type="List" default="[]"/>
    <aura:attribute name="tab3Records" type="List" default="[]"/>
    <aura:attribute name="tab4Records" type="List" default="[]"/>
    <aura:attribute name="tab5Records" type="List" default="[]"/>

    <aura:attribute name="tab1CurrentPage" type="Integer" default="1"/>
    <aura:attribute name="tab2CurrentPage" type="Integer" default="1"/>
    <aura:attribute name="tab3CurrentPage" type="Integer" default="1"/>
    <aura:attribute name="tab4CurrentPage" type="Integer" default="1"/>
    <aura:attribute name="tab5CurrentPage" type="Integer" default="1"/>

    <aura:attribute name="tab1TotalPages" type="Integer" default="1"/>
    <aura:attribute name="tab2TotalPages" type="Integer" default="1"/>
    <aura:attribute name="tab3TotalPages" type="Integer" default="1"/>
    <aura:attribute name="tab4TotalPages" type="Integer" default="1"/>
    <aura:attribute name="tab5TotalPages" type="Integer" default="1"/>
    
    
    <!--Componenet-->    
    <div style="background-color:White; border-radius:.55rem;">
        <!--Header-->
        <div class="slds-page-header" style="border-radius: .55rem;">
            <div class="slds-media">
                <div class="slds-media__body slds-show" aura:id="NormalHeading">
                    <lightning:icon iconName="custom:custom31" alternativeText="Journey" title="Journey" class="slds-float_left"/>
                    
                    <h1 class="slds-page-header__title slds-text-heading_large slds-truncate slds-align-middl slds-p-left_small " title="Journey"><strong>Journey</strong></h1>
                </div> 
                <!--  Profile photo Card  -->
                <div class="slds-media__body slds-hide" aura:id="ProfileDeatilHeading" >
                    <span class="slds-avatar slds-avatar_circle slds-avatar_medium" style="float: left;">
                        <img alt="{!v.SelectedUserProfile.Name}" src="{!v.SelectedUserProfile.SmallPhotoUrl}" title="{!v.SelectedUserProfile.Name}" />
                    </span>                
                    <h4 class="slds-page-header__title slds-text-heading_large slds-truncate slds-align-middl slds-p-left_small "  style="float:left;"><strong>{!v.SelectedUserProfile.Name}</strong></h4>
                </div>
                <!-- <div style="float:right;">
                <div aura:id="hideThis" style="display:block ;">
                <lightning:button variant="brand" label="Submit For Approval" disabled="{!v.ButtonDisable}" title="Submit For Approval" onclick="{!c.SubmitforApproval}"/>
            </div>
            </div> -->
                
                <div style="float:right;" aura:id="TeamJourney" class="slds-hide">
                    <div aura:id="hideThis" style="display:block;">
                        <lightning:button variant="brand" label="Team Journey" disabled="{}" title="Team Journey" onclick="{!c.hideMyJourneyView}"/> 
                    </div>
                </div>
                
                <div style="float:right;" aura:id="MyJourneyBtn" class="slds-hide">
                    <div aura:id="hideThis" style="display:block;">
                        <lightning:button variant="brand" label="My Journey" disabled="{}" title="My Journey" onclick="{!c.hideTeamView}"/>
                    </div>
                </div>
            </div>
        </div>
        <!--Body-->
        <div class="slds-form slds-form_compound" aura:id="MyJourney">
            <div class="slds-form-element__group">
                <div class="slds-form-element__row slds-align_absolute-center"> 
                    <div class="slds-form-element slds-size-1-of-1">
                        <label class="slds-form-element__label slds-align_absolute-center"  for="input-id-01" style="font-size: 20px;">
                            <abbr class="slds-required" title="required">*</abbr><strong>Select the Month</strong></label>
                        <div class="slds-align_absolute-center">
                            <!-- <lightning:input type="date" class="slds-float_left" name="input1" value="{!v.StartDate}"  placeholder="Enter Start Date" title="Enter Start Date" min="{!v.MinDate}" max="{!v.MaxDate}"  />
                        <lightning:input type="date" class="slds-float_left" name="input2" value="{!v.EndDate}" placeholder="Enter End Date" title="Enter End Date" min="{!v.MinDate}" max="{!v.MaxDate}" onchange="{!c.LoadTable}"  />
                        -->  
                            <!--Month Input-->
                            <lightning:input type="month" class="slds-float_left" name="input1" value="{!v.Month}"  placeholder="Enter Start Date" title="Enter Start Date" min="{!v.MinDate}" max="{!v.MaxDate}" onchange="{!c.LoadTableMonth}" />    
                        </div>
                    </div>
                </div>
                <br/>
                <br/>
                <div style="width:100%; padding:0 2% 0 2%;" >
                    <!--Summary Tab-->
                    <aura:if isTrue="{!v.OpenIf}">    
                        <div  class="slds-card" style="height:60px;">
                            <div style="padding: 15px 0px 0px 30px; font-size:1.5em; width:18%; float:left ">
                                <b>Total Journeys:{!v.TotalJourney}</b>
                            </div>
                            <div style="padding: 15px 0px 0px 0px; font-size:1.5em; width:16%; float:left ">
                                <b>Total Events:{!v.TotalEvent}</b>
                                
                            </div>
                            <div style="padding: 15px 0px 0px 0px; font-size:1.5em; width:23%; float:left ">
                                <b>Total Amount:{!v.TotalAmount} Rs</b>
                            </div>
                            <div style="padding: 15px 0px 0px 0px; font-size:1.5em; width:25%; float:left ">
                                <b>Approved Amount:{!v.TotalApprovedAmount} Rs</b>
                            </div>
                            <div style="padding: 15px 0px 0px 0px; font-size:1.5em; width:18%; float:left ">
                                <b>Total Distance:{!v.TotalDistance} KM</b>
                            </div>
                        </div>
                    </aura:if>
                    </div>
                    <!--Journey  List View-->
                <div class="slds-m-top_x-small slds-align_absolute-center" style="width:100%; padding:0 2% 0 2%;" >
                    <lightning:tabset selectedTabId="ten">
                        <lightning:tab label="To be Submitted" id="ten" >
                            <div>
                                <aura:iteration items="{!v.myJourneyListToBeSubmitted}" var="Jor" indexVar="index">
                                    <lightning:accordion aura:id="accordion" class="slds-card slds-border_top" onsectiontoggle="{! c.handleSectionToggle }" activeSectionName="{!v.ActiveId}" allowMultipleSectionsOpen="True" >
                                        <div  class="slds-card">
                                            <lightning:accordionSection aura:id="accourd"   name="{!Jor.Id}" label="{!Jor.Name}" >
                                                <aura:set attribute="actions"><div style="width:80%">
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Date:{!Jor.Journey_Date__c}</div>
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Distance:{!Jor.Journey_KM__c}</div>
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Amount:{!Jor.Final_Amount__c}</div>
                                                    <div style="width:30%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Status:{!Jor.Approval_Status__c}</div>
                                                    <div style="float:right; padding-right:5px; font-size:10px">
                                                        <!-- <lightning:buttonIcon iconName="utility:settings" name="{!Jor.Id}"  size="xx-small" alternativeText="Map" onclick="{!c.openMap}"/> -->
                                                        <button name="lead" class="slds-button">
                                                            <span data-value="{!Jor.Id}"  onclick="{!c.openMap}">
                                                                <lightning:icon iconName="action:map" size="xx-small"/>
                                                            </span>
                                                        </button>
                                                        <!--<ui:inputCheckbox aura:id="checkbox" label="" change=""/> 
                                    -->
                                                    </div>
                                                    </div>
                                                </aura:set>
                                                <aura:set attribute="body">
                                                    <!-- <aura:unescapedHtml value=""/>
                                            <br/> -->
                                                    <!--Events List View Table-->
                                                    <b style="Font-size:20px">Events</b>
                                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                                        <thead>
                                                            <tr class="slds-line-height_reset">
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Name">Name</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Status">Status</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Purpose">Purpose</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Distance">Distance</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Campaign">Campaign</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Time Spent (in minutes)">Time Spent<br/>(in minutes)</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Contact">Contact</div>
                                                                </th>
                                                                
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <aura:iteration items="{!v.EventList}" var="Eve">
                                                                <tr class="slds-hint-parent">
                                                                    <th data-label="Opportunity Name" scope="row">
                                                                        <div class="slds-truncate"  title="{!Eve.Name}">
                                                                            <a href="javascript:void(0);" tabindex="-1" Name="{!Eve.Id}" onclick="{!c.openOnNewWindow}">{!Eve.Name}</a>
                                                                        </div>
                                                                    </th>
                                                                    <td data-label="Account Name">
                                                                        <div class="slds-truncate" title="{!Eve.Status__c}">{!Eve.Status__c}</div>
                                                                    </td>
                                                                    <td data-label="Close Date">
                                                                        <div class="slds-truncate" title="{!Eve.Event_Purpose__c}">{!Eve.Event_Purpose__c}</div>
                                                                    </td>
                                                                    <td data-label="Prospecting">
                                                                        <div class="slds-truncate" title="{!Eve.Distance__c}">{!Eve.Distance__c}</div>
                                                                    </td>
                                                                    <td data-label="Confidence">
                                                                        <div class="slds-truncate" title="{!Eve.Campaign__c}">{!Eve.Campaign__r.Name}</div>
                                                                    </td>
                                                                    <td data-label="Amount">
                                                                        <div class="slds-truncate" title="{!Eve.Time_Spent_Auto__c}">{!Eve.Time_Spent_Auto__c}</div>
                                                                    </td>
                                                                    <td data-label="Amount">
                                                                        <div class="slds-truncate" title="{!Eve.Contact__c}">{!Eve.Contact__r.Name}</div>
                                                                    </td>
                                                                </tr>
                                                            </aura:iteration>
                                                        </tbody>
                                                    </table>
                                                    <br/> 
                                                    <!--Expense Items View Table-->
                                                    <div style="width: 100%;">
                                                        <b style="Font-size:20px; float:left">Expense Items</b>
                                                        <div style="float: right;">
                                                            <lightning:button variant="base" label="Add New" title="Add New" name="{!v.JorId}" onclick="{!c.openForm}"/>
                                                        </div>    
                                                    </div>
                                                    <br/>
                                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered" max-column-width="50px">
                                                        <thead>
                                                            <tr class="slds-line-height_reset">
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Name">Name</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Amount">Amount</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Bill Number">Bill Number</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Expense Type">Expense Type</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Check-In Date" >Comment</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Check-Out Date">Upload/Delete/View Files</div>
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <aura:iteration items="{!v.ExList}" var="Ex">
                                                                <tr class="slds-hint-parent">
                                                                    <th data-label="Opportunity Name" scope="row">
                                                                        <div class="slds-truncate" title="{!Ex.Name}">
                                                                            <a href="javascript:void(0);" tabindex="-1" Name="{!Ex.Id}" onclick="{!c.openOnNewWindow}">{!Ex.Name}</a>
                                                                        </div>
                                                                    </th>
                                                                    <td data-label="Account Name">
                                                                        <div class="slds-truncate" title="{!Ex.Amount__c}">{!Ex.Amount__c}</div>
                                                                    </td>
                                                                    <td data-label="Close Date">
                                                                        <div class="slds-truncate" title="{!Ex.Bill_Number__c}">{!Ex.Bill_Number__c}</div>
                                                                    </td>
                                                                    <td data-label="Prospecting">
                                                                        <div class="slds-truncate" title="{!Ex.Expense_Type__c}">{!Ex.Expense_Type__c}</div>
                                                                    </td>
                                                                    <td data-label="Confidence" style="max-width: 130px">
                                                                        <div class="slds-truncate" title="{!Ex.Check_In_Date__c}">{!Ex.Comment__c}</div>
                                                                    </td>
                                                                    <td data-label="Amount">
                                                                        <!-- <div class="slds-truncate" title="{!Ex.Check_Out_Date__c}">{!Ex.Check_Out_Date__c}</div> -->
                                                                        <button name="" class="slds-button">
                                                                            <span data-value="{!Ex.Id}"  onclick="{!c.dothis}">
                                                                                <lightning:icon iconName="action:add_file" size="xx-small"/>
                                                                            </span>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </aura:iteration>
                                                        </tbody>
                                                    </table>
                                                    <br/>
                                                    <!--Submit for Approval Button-->
                                                    <lightning:button  variant="brand" name="{!Jor.Id}" label="Submit for Approval" title="Submit" onclick="{!c.SubmitforApprovalSingle}"/>
                                                    <lightning:button name="{!Jor.Id}" label="Not To Be Claimed" title="Not To Be Claimed" onclick="{!c.JourneyStatusNotToBeClaimed}"/>

                                                </aura:set>
                                            </lightning:accordionSection>
                                        </div>
                                    </lightning:accordion>
                                </aura:iteration>
                            </div>
                        </lightning:tab>
                        <!--Tab one-->
                        <lightning:tab label="To Approve" id="six" >
                            <div>
                                <aura:iteration items="{!v.JourneyList}" var="Jor" indexVar="index">
                                    <lightning:accordion aura:id="accordion" class="slds-card slds-border_top" onsectiontoggle="{! c.handleSectionToggle }" activeSectionName="{!v.ActiveId}" allowMultipleSectionsOpen="True" >
                                        <div  class="slds-card">
                                            <lightning:accordionSection aura:id="accourd"   name="{!Jor.Id}" label="{!Jor.Name}" >
                                                <aura:set attribute="actions"><div style="width:80%">
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Date:{!Jor.Journey_Date__c}</div>
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Distance:{!Jor.Journey_KM__c}</div>
                                                    <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Amount:{!Jor.Final_Amount__c}</div>
                                                    <div style="width:30%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Status:{!Jor.Approval_Status__c}</div>
                                                    <div style="float:right; padding-right:5px; font-size:10px">
                                                        <!-- <lightning:buttonIcon iconName="utility:settings" name="{!Jor.Id}"  size="xx-small" alternativeText="Map" onclick="{!c.openMap}"/> -->
                                                        <button name="lead" class="slds-button">
                                                            <span data-value="{!Jor.Id}"  onclick="{!c.openMap}">
                                                                <lightning:icon iconName="action:map" size="xx-small"/>
                                                            </span>
                                                        </button>
                                                        <!--<ui:inputCheckbox aura:id="checkbox" label="" change=""/> 
                                    -->
                                                    </div>
                                                    </div>
                                                </aura:set>
                                                <aura:set attribute="body">
                                                    <!-- <aura:unescapedHtml value=""/>
                                            <br/> -->
                                                    <!--Events List View Table-->
                                                    <b style="Font-size:20px">Events</b>
                                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered">
                                                        <thead>
                                                            <tr class="slds-line-height_reset">
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Name">Name</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Status">Status</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Purpose">Purpose</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Distance">Distance</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Campaign">Campaign</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Time Spent (in minutes)">Time Spent<br/>(in minutes)</div>
                                                                </th>
                                                                <th class="" scope="col">
                                                                    <div class="slds-truncate" title="Contact">Contact</div>
                                                                </th>
                                                                
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <aura:iteration items="{!v.EventList}" var="Eve">
                                                                <tr class="slds-hint-parent">
                                                                    <th data-label="Opportunity Name" scope="row">
                                                                        <div class="slds-truncate"  title="{!Eve.Name}">
                                                                            <a href="javascript:void(0);" tabindex="-1" Name="{!Eve.Id}" onclick="{!c.openOnNewWindow}">{!Eve.Name}</a>
                                                                        </div>
                                                                    </th>
                                                                    <td data-label="Account Name">
                                                                        <div class="slds-truncate" title="{!Eve.Status__c}">{!Eve.Status__c}</div>
                                                                    </td>
                                                                    <td data-label="Close Date">
                                                                        <div class="slds-truncate" title="{!Eve.Event_Purpose__c}">{!Eve.Event_Purpose__c}</div>
                                                                    </td>
                                                                    <td data-label="Prospecting">
                                                                        <div class="slds-truncate" title="{!Eve.Distance__c}">{!Eve.Distance__c}</div>
                                                                    </td>
                                                                    <td data-label="Confidence">
                                                                        <div class="slds-truncate" title="{!Eve.Campaign__c}">{!Eve.Campaign__r.Name}</div>
                                                                    </td>
                                                                    <td data-label="Amount">
                                                                        <div class="slds-truncate" title="{!Eve.Time_Spent_Auto__c}">{!Eve.Time_Spent_Auto__c}</div>
                                                                    </td>
                                                                    <td data-label="Amount">
                                                                        <div class="slds-truncate" title="{!Eve.Contact__c}">{!Eve.Contact__r.Name}</div>
                                                                    </td>
                                                                </tr>
                                                            </aura:iteration>
                                                        </tbody>
                                                    </table>
                                                    <br/> 
                                                    <!--Expense Items View Table-->
                                                    <div style="width: 100%;">
                                                        <b style="Font-size:20px; float:left">Expense Items</b>
                                                        <div style="float: right;">
                                                            <lightning:button variant="base" label="Add New" title="Add New" name="{!v.JorId}" onclick="{!c.openForm}"/>
                                                        </div>    
                                                    </div>
                                                    <br/>
                                                    <table class="slds-table slds-table_cell-buffer slds-table_bordered" max-column-width="50px">
                                                        <thead>
                                                            <tr class="slds-line-height_reset">
                                                                <th class="" scope="col">
