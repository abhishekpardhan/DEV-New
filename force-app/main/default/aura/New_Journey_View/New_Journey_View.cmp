    <!--Map view Modal Tab-->
    <aura:if isTrue="{!v.isOpen}">
        <div>
            <section role="dialog" tabindex="-1" class="slds-modal slds-fade-in-open slds-modal_small" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1">
                <div class="slds-modal__container">
                    <header class="slds-modal__header">
                        <!--  <button class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" title="Close">
                
                <span class="slds-assistive-text">Close</span>
            </button> -->
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{!c.closeMap}"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-modal__title slds-hyphenate">Map</h2>
                    </header>
                    <!-- attributes -->
                    <!-- the map component -->
                    <aura:if isTrue="{!v.mapMarkers.length > 0}" >
                        <!--<lightning:map 
                        mapMarkers="{! v.mapMarkers }" />-->
                        <!-- markersTitle="{!v.markersTitle}"
                        center="{!v.center}" -->
                        <lightning:map 
                                       mapMarkers="{! v.mapMarkers }" 
                                       center="{! v.center }"
                                       zoomLevel="{! v.zoomLevel }"
                                       markersTitle="{! v.markersTitle }"
                                       showFooter="{! v.showFooter }" />  
                        
                    </aura:if>
                    
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" 
                                          label="Close"
                                          title="Close"
                                          onclick="{! c.closeMap }"/>
                        
                        <!-- <button class="slds-button slds-button_brand">Save</button> -->
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </div>
    </aura:if>
    <!--Add New Expence tab-->
    <aura:if isTrue="{!v.openNewExpense}">
        <div>
            <section role="dialog" tabindex="-1" class="slds-modal slds-fade-in-open slds-modal_small" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1">
                <div class="slds-modal__container">
                    <header class="slds-modal__header">
                        <!--  <button class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" title="Close">
                
                <span class="slds-assistive-text">Close</span>
            </button> -->
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{!c.closeExpense}"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-modal__title slds-hyphenate">New Expense Item</h2>
                    </header>
                    <div style="background-color: white;" >
                        {!v.ExpenseType}
                        <br/>
                        <div class="slds-grid slds-wrap" >
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center"> 
                                <lightning:input class="form-field" name="" type="text" required="true" value="{!v.CreateExpense.Name}" placeholder="Name" label="Expense Item Name"/> 
                            </div>
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center">
                                <lightning:input class="form-field" type="number" value="{!v.CreateExpense.Amount__c}" placeholder="0" name="" label="Amount" />                       
                            </div>
                        </div>
                        <br/>
                        <div class="slds-grid slds-wrap" >
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center"> 
                                <lightning:select class="form-field" name="" value="{!v.CreateExpense.Expense_Type__c}" label="Select Expense Type">
                                    <option text="Select Type" value="Select Type"></option>
                                    <aura:iteration items="{!v.ExpenseType}" var="Type">
                                        <option text="{!Type}"></option>
                                    </aura:iteration>
                                </lightning:select> 
                            </div>
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center">
                                <lightning:input class="form-field" name=""  value="{!v.CreateExpense.Bill_Number__c}" placeholder="Bill Number" label="Bill Number"/>                        
                            </div>
                        </div>
                        <br/>
                        <div class="slds-grid slds-wrap" >
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center"> 
                                <lightning:input class="form-field" name=""  value="{!v.CreateExpense.If_Others_Please_specify__c}" placeholder="If Others, Please specify" label="If Others, Please specify"/>
                            </div>
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center">
                                <lightning:input class="form-field" name="input6" value="{!v.CreateExpense.Comment__c}" placeholder="Comment" label="Comment"/>                        
                            </div>
                        </div>
                        <br/>
                        <div class="slds-grid slds-wrap" >
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center"> 
                                <!-- <lightning:input aura:id="fuploader" onchange="{!c.handleFilesChange}" type="file" name="file" label="Upload File" multiple="false"/>
                <br/>
        <p class="slds-text-body_small slds-text-color_error">{!v.fileName} </p> -->    
                            </div>
                            <div class="slds-col slds-size_1-of-2 slds-align_absolute-center">
                                <!-- <lightning:input class="form-field" name="input6"  value="" placeholder="Comment" label="Comment"/>                         -->
                            </div> 
                        </div>
                        <br/>
                        <br/>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" 
                                          label="Cancel"
                                          title="Cancel"
                                          onclick="{!c.closeExpense}"/>
                        <lightning:button variant="Brand" 
                                          label="Save"
                                          title="Save"
                                          onclick="{!c.SaveExpense}"/>
                        <!-- <button class="slds-button slds-button_brand">Save</button> -->
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>        
        </div>
    </aura:if>
    
    <!--Rejection Reason for team view-->
    <aura:if isTrue="{!v.Rejection}">
        <div>
            <section role="dialog" tabindex="-1" class="slds-modal slds-fade-in-open slds-modal_small" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1">
                <div class="slds-modal__container">
                    <header class="slds-modal__header">
                        <!--  <button class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" title="Close">
                        
                        <span class="slds-assistive-text">Close</span>
                    </button> -->
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{!c.closeRejectionReason}"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-modal__title slds-hyphenate">Reason</h2>
                    </header>
                    <div style="background-color: white;" >
                        <br/>
                        <div class="slds-grid slds-wrap" >
                            <div class="slds-col slds-size_1-of-1 slds-align_absolute-center"> 
                                <lightning:textarea name="input1" required="true" label="Rejection Reason" style="width: 80%;" maxlength="15" value="{!v.comment}"/> 
                            </div>
                        </div>
                        <br/>
                        <br/>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" 
                                          label="Cancel"
                                          title="Cancel"
                                          onclick="{!c.closeRejectionReason}"/>
                        <lightning:button variant="Brand" 
                                          label="Reject"
                                          title="Reject"
                                          onclick="{!c.JourneyrejectedByManager}"/> <!--!c.JourneyrejectedByManager-->
                        <!-- <button class="slds-button slds-button_brand">Save</button> -->
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>        
        </div>
    </aura:if>
</aura:component>