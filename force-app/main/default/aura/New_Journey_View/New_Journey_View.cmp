                            -->
                                                        </div>
                                                        </div>
                                                    </aura:set>
                                                    <aura:set attribute="body">
                                                        <!-- <aura:unescapedHtml value=""/>
                                    <br/> -->
                                                        <!--Events List View Table-->
                                                        <div style="font-size:15px; padding-top: 5px;">
                                                            <b>Journey Remark:</b> {!Jor.Remarks__c}
                                                        </div>
                                                        <aura:if isTrue="{!v.AuditSectionVisibility}" >
