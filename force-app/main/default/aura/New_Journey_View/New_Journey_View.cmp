                                                        <lightning:button  name="{!Jor.Id}" label="Reject" title="Reject" onclick="{!c.openRejection}"/>
                                                    </aura:set>
                                                </lightning:accordionSection>
                                            </div>
                                        </lightning:accordion>
                                    </aura:iteration>
                                    <br/>
                                    <br/> 
                                
                                </div>
                            </aura:if>
                            <!-- Center the pagination buttons -->
                            <div style="display: flex; justify-content: center; align-items: center;">
                                <lightning:button label="Previous"
                                                  onclick="{!c.changePage}"
                                                  name="prev5"
                                                  disabled="{!v.tab5CurrentPage == 1}" />
                                
