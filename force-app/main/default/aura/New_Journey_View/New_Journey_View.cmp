                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Date:{!Jor.Journey_Date__c}</div>
                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Distance:{!Jor.Journey_KM__c}</div>
                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Amount:{!Jor.Final_Amount__c}</div>
                                                        <div style="width:30%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Status:{!Jor.Approval_Status__c}</div>
                                                        <div style="float:right; padding-right:5px; font-size:10px">
                                                            <!-- <lightning:buttonIcon iconName="utility:settings" name="{!Jor.Id}"  size="xx-small" alternativeText="Map" onclick="{!c.openMap}"/> -->
