                                        <lightning:accordion aura:id="accordion"  class="slds-card slds-border_top" onsectiontoggle="{! c.handleSectionToggle }" activeSectionName="{!v.ActiveId}" allowMultipleSectionsOpen="True" >
                                            <div  class="slds-card" style="border:1px solid LightGray">
                                                <lightning:accordionSection aura:id="accourd"   name="{!Jor.Id}" label="{!Jor.Name}" >
