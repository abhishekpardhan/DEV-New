                                                                        <div class="slds-truncate" title="Contact">Contact</div>
                                                                    </th>
                                                                    <th class="" scope="col">
                                                                        <div class="slds-truncate" title="Contact">Remark</div>
                                                                    </th>
                                                                    
                                                                </tr>
                                                            </thead>
                                                            <tbody>
