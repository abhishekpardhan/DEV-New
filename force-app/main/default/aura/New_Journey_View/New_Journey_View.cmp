                                                                        <div class="slds-truncate" title="Check-Out Date">Upload/Delete/View Files</div>
                                                                    </th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <aura:iteration items="{!v.ExList}" var="Ex">
                                                                    <tr class="slds-hint-parent">
