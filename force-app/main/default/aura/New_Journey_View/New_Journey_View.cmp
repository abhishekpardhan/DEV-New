                                                        </td>
                                                        <td data-label="Amount">
                                                            <div class="slds-truncate" title="{!Eve.Contact__c}">{!Eve.Contact__r.Name}</div>
                                                        </td>
                                                    </tr>
                                                </aura:iteration>
                                            </tbody>
                                        </table>
                                        <br/> 
                                        <!--Expense Items View Table-->
                                        <div style="width: 100%;">
                                            <b style="Font-size:20px; float:left">Expense Items</b>
