                                                <lightning:button variant="base" label="Add New" title="Add New" name="{!v.JorId}" onclick="{!c.openForm}"/>
                                            </div>    
                                        </div>
                                        <br/>
                                        <table class="slds-table slds-table_cell-buffer slds-table_bordered" max-column-width="50px">
                                            <thead>
                                                <tr class="slds-line-height_reset">
                                                    <th class="" scope="col">
                                                        <div class="slds-truncate" title="Name">Name</div>
                                                    </th>
                                                    <th class="" scope="col">
                                                        <div class="slds-truncate" title="Amount">Amount</div>
                                                    </th>
                                                    <th class="" scope="col">
                                                        <div class="slds-truncate" title="Bill Number">Bill Number</div>
                                                    </th>
                                                    <th class="" scope="col">
