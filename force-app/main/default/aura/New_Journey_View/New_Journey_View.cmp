        </div>
        
        <!--@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ Team Journey view @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-->
        
        <div class="slds-form slds-form_compound slds-hide" aura:id="TeamJourneyView">
            <div class="slds-form-element__group">
                <div class="slds-form-element__row slds-align_absolute-center"> 
                    <div class="slds-form-element slds-size-1-of-2">
                        <!--   <label class="slds-form-element__label slds-align_absolute-center"  for="input-id-01" style="font-size: 20px;">
                    <abbr class="slds-required" title="required">*</abbr><strong>Select User</strong></label>  -->
                        <div class="slds-align_absolute-center">
                            <lightning:select name="mySelect1" label="Select User" aura:id="User" onchange="{!c.selectUser}">
                                <!--  "{!v.UserId1}"  -->
                                <option value="">Select a user</option>
                                <aura:iteration items="{!v.Users}" var="User">
                                    <option value="{!User.Id}">{!User.Name}</option>  <!-- selected="{!User.Id}"/> -->
                                </aura:iteration>
                            </lightning:select>   
                        </div>
                    </div>
                    <div class="slds-form-element slds-size-1-of-2">
                        <!--   <label class="slds-form-element__label slds-align_absolute-center"  for="input-id-01" style="font-size: 20px;">
                    <abbr class="slds-required" title="required">*</abbr><strong>Select Month</strong></label> -->
                        <div class="slds-align_absolute-center">
                            <!-- <lightning:input type="date" class="slds-float_left" name="input1" value="{!v.StartDate}"  placeholder="Enter Start Date" title="Enter Start Date" min="{!v.MinDate}" max="{!v.MaxDate}"  />
                    <lightning:input type="date" class="slds-float_left" name="input2" value="{!v.EndDate}" placeholder="Enter End Date" title="Enter End Date" min="{!v.MinDate}" max="{!v.MaxDate}" onchange="{!c.LoadTable}"  />
                    -->  
                            <!--Month Input-->
                            <lightning:input type="month"
                                             name="monthInput"
                                             value="{!v.Month1}"
                                             label="Select Month"
                                             onchange="{!c.handleMonthChange}" />  
                            
                            
                            <!-- Date Picker (Only days within the selected month are enabled) -->
                            <aura:if isTrue="{!not(empty(v.Month1))}">
                                <lightning:input type="date"
                                                 label="Select Day"
                                                 value="{!v.SelectedDate}"
                                                 min="{!v.MinDateForDay}"
                                                 max="{!v.MaxDateForDay}"
                                                 onchange="{!c.handleDaySelection}"
                                                 disabledDates="{!v.DisabledDates}" />
                            </aura:if>
                            
                            <!-- Error Message -->
                            <aura:if isTrue="{!v.DateError}">
                                <div class="slds-text-color_error slds-m-top_x-small">
                                    Selected date is not in the selected month. Please choose a valid date.
                                </div>
                            </aura:if>

                            
                        </div>
                    </div>
                </div>
                <br/>
                <div style="width:100%; padding:0 2% 0 2%;" >
                    <!--Summary Tab-->
                    <aura:if isTrue="{!v.OpenIf}">    
                        <div  class="slds-card" style="height:40px;">
                            <div style="padding: 5px 0px 0px 30px; font-size:1.5em; width:18%; float:left ">
                                <b>Total Journeys:{!v.TotalJourneyTeam}</b>
                            </div>
                            <div style="padding: 5px 0px 0px 0px; font-size:1.5em; width:16%; float:left ">
                                <b>Total Events:{!v.TotalEventTeam}</b>
                            </div>
                            <div style="padding: 5px 0px 0px 0px; font-size:1.5em; width:23%; float:left ">
                                <b>Total Amount:{!v.TotalAmountTeam} Rs</b>
                            </div>
                            <div style="padding: 5px 0px 0px 0px; font-size:1.5em; width:25%; float:left ">
                                <b>Approved Amount:{!v.TotalApprovedAmountTeam} Rs</b>
                            </div>
                            <div style="padding: 5px 0px 0px 0px; font-size:1.5em; width:18%; float:left ">
                                <b>Total Distance:{!v.TotalDistanceTeam} KM</b>
                            </div>
                        </div>
                    </aura:if>
                </div>
                <div class="slds-m-top_x-small slds-align_absolute-center" style="width:100%; padding:0 2% 0 2%;" >
                    <lightning:tabset selectedTabId="five">
                         <lightning:tab label="To be Submitted" id="five">
                            <!--Tab Five-->
                            <aura:if isTrue="{!v.isLoading}">
                                <lightning:spinner alternativeText="Loading..." size="medium" />
                            </aura:if>
                            <aura:if isTrue="{!not(v.isLoading)}">
                                <div>
                                    <!--Journey  List View-->
                                    <aura:iteration items="{!v.JourneyListToBeSubmitted}" var="Jor" indexVar="index">
                                        <lightning:accordion aura:id="accordion"  class="slds-card slds-border_top" onsectiontoggle="{! c.handleSectionToggle }" activeSectionName="{!v.ActiveId}" allowMultipleSectionsOpen="True" >
                                            <div  class="slds-card" style="border:1px solid LightGray">
                                                <lightning:accordionSection aura:id="accourd"   name="{!Jor.Id}" label="{!Jor.Name}" >
                                                    <aura:set attribute="actions"><div style="width:80%">
                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Date:{!Jor.Journey_Date__c}</div>
                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Distance:{!Jor.Journey_KM__c}</div>
                                                        <div style="width:20%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Amount:{!Jor.Final_Amount__c}</div>
                                                        <div style="width:30%; float:left; font-weight:bold; font-size:15px; padding-top: 5px;">Status:{!Jor.Approval_Status__c}</div>
                                                        <div style="float:right; padding-right:5px; font-size:10px">
                                                            <!-- <lightning:buttonIcon iconName="utility:settings" name="{!Jor.Id}"  size="xx-small" alternativeText="Map" onclick="{!c.openMap}"/> -->
                                                            <button name="lead" class="slds-button">
                                                                <span data-value="{!Jor.Id}"  onclick="{!c.openMap}">
                                                                    <lightning:icon iconName="action:map" size="xx-small"/>
                                                                </span>
                                                            </button>
                                                            <!--<ui:inputCheckbox aura:id="checkbox" label="" change=""/> 
                            -->
                                                        </div>
                                                        </div>
                                                    </aura:set>
