<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Zip_code_should_be_6_digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(  ZIP_Code__c ),NOT(REGEX( ZIP_Code__c , &quot;\\d{6}&quot;)))</errorConditionFormula>
    <errorDisplayField>ZIP_Code__c</errorDisplayField>
    <errorMessage>Pin Code Should be 6 Digits</errorMessage>
</ValidationRule>
