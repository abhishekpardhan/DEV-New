<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pin_code_6_didgit</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW(),ISCHANGED(Pin_Code__c)),!ISBLANK(Pin_Code__c),NOT(REGEX(Pin_Code__c, &quot;\\d{6}&quot;)))</errorConditionFormula>
    <errorDisplayField>Pin_Code__c</errorDisplayField>
    <errorMessage>Pin Code Should be 6 Digits.</errorMessage>
</ValidationRule>
