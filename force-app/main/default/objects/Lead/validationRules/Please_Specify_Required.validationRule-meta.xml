<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Please_Specify_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Lead_Drop_Reason__c, &quot;Others&quot;),
    ISBLANK(Please_Specify__c)
)</errorConditionFormula>
    <errorDisplayField>Please_Specify__c</errorDisplayField>
    <errorMessage>Please Specify is required when Lead Drop Reason is Other.</errorMessage>
</ValidationRule>
