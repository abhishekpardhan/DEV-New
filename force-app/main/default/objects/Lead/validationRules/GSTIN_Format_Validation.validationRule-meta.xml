<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GSTIN_Format_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(GST_Number__c)),
    NOT(
        REGEX(
            GST_Number__c,
            &quot;^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$&quot;
        )
    )
)</errorConditionFormula>
    <errorMessage>Enter a valid 15-character GST Number.</errorMessage>
</ValidationRule>
