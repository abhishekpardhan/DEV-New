<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CSC_Local_Sales_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 

ISPICKVAL( Type__c , &quot;CSC&quot;), 

	ISNULL(Local_Sales__c)
	
)</errorConditionFormula>
