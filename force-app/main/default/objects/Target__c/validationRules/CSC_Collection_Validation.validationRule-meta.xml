<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CSC_Collection_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 

ISPICKVAL( Type__c , &quot;CSC&quot;), 

	ISNULL(Collection__c)

)</errorConditionFormula>
    <errorDisplayField>Collection__c</errorDisplayField>
    <errorMessage>Please fill Collection.</errorMessage>
</ValidationRule>
