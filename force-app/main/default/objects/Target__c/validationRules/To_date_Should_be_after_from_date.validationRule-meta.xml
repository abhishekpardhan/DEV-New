<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>To_date_Should_be_after_from_date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED( To_Date__c )),!ISBLANK(To_Date__c ) ,To_Date__c &lt;  From_Date__c )</errorConditionFormula>
    <errorDisplayField>To_Date__c</errorDisplayField>
    <errorMessage>To Date should be after From Date.</errorMessage>
</ValidationRule>
