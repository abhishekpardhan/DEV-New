<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CSC_Delivery_Sales_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 

ISPICKVAL( Type__c , &quot;CSC&quot;), 
 
	ISNULL(Delivery_Sales__c) 
)</errorConditionFormula>
    <errorDisplayField>Delivery_Sales__c</errorDisplayField>
    <errorMessage>Please fill Delivery Sales.</errorMessage>
</ValidationRule>
