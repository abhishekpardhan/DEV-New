<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_Sales_No_of_Contract_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 

ISPICKVAL( Type__c , &quot;New Sales&quot;), 

ISNULL(No_of_Contract__c)

)</errorConditionFormula>
    <errorDisplayField>No_of_Contract__c</errorDisplayField>
    <errorMessage>Please fill No of Contract.</errorMessage>
</ValidationRule>
