<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>check_out_date_man</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Expense_Type__c)) , ISPICKVAL(Expense_Type__c, &apos;Hotel&apos;),ISBLANK(Check_Out_Date__c))</errorConditionFormula>
    <errorDisplayField>Check_Out_Date__c</errorDisplayField>
    <errorMessage>Please fill Check out Date.</errorMessage>
</ValidationRule>
