<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Checkin_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Expense_Type__c)) , ISPICKVAL(Expense_Type__c, &apos;Hotel&apos;),ISBLANK( Check_In_Date__c))</errorConditionFormula>
    <errorDisplayField>Check_In_Date__c</errorDisplayField>
    <errorMessage>Please fill check In date.</errorMessage>
</ValidationRule>
