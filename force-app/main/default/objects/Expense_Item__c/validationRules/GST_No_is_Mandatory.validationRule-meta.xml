<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GST_No_is_Mandatory</fullName>
    <active>false</active>
    <description>GST No. is Mandatory if Expense is of Hotel type</description>
    <errorConditionFormula>AND(ISPICKVAL( Expense_Type__c,&apos;Hotel Expenses&apos;),ISBLANK( GST_No__c ))</errorConditionFormula>
    <errorMessage>GST No. is Mandatory</errorMessage>
</ValidationRule>
