<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Waybill_Number_validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Name)),!REGEX(Name,&quot;^\\d{8,}?$&quot;) 
)</errorConditionFormula>
    <errorMessage>Please enter minimum 8 digit waybill number.</errorMessage>
</ValidationRule>
