<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Same_contact_on_OppCon_and_opp_acc</fullName>
    <active>false</active>
    <errorConditionFormula>IF((Contact__r.Account.Id != Opportunity__r.Account__r.Id), true, false)</errorConditionFormula>
