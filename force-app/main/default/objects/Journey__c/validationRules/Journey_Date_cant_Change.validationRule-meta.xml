<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Journey_Date_cant_Change</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISCHANGED(Journey_Date__c), OR(!ISBLANK( CheckIn_Date__c ), 
!ISBLANK(CheckOut_Date__c)
))</errorConditionFormula>
    <errorMessage>Journey Date cant be changed after check-in</errorMessage>
</ValidationRule>
