<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Journey_Date_future_Date</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Journey_Date__c)) ,Journey_Date__c &lt; TODAY())</errorConditionFormula>
    <errorDisplayField>Journey_Date__c</errorDisplayField>
    <errorMessage>Please fill future Date.</errorMessage>
</ValidationRule>
