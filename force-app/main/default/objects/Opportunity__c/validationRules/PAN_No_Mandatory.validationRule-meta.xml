<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PAN_No_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Permission.Skip_Validation_Rule = false,ISPICKVAL(Stage__c,&apos;Closed Won&apos;),ISBLANK(PAN_No__c),!ISPICKVAL( Type__c ,&apos;Retail&apos;),$Profile.Name != &apos;Integration User&apos;)</errorConditionFormula>
