<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Update_Account_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Account__c), NOT(ISNULL(Account__c)), Text( Customer_Type__c)=&quot;Renewal Opportunity&quot;)</errorConditionFormula>
    <errorDisplayField>Account__c</errorDisplayField>
    <errorMessage>You cannot update MSA for Renewal Opportunity.</errorMessage>
</ValidationRule>
