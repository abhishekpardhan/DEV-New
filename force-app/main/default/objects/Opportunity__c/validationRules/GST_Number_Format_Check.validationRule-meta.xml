<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GST_Number_Format_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
				$Permission.Skip_Validation_Rule = false,
!ISBLANK( GST_Number__c ) ,
!REGEX( GST_Number__c , &quot;[0-9]{2}(([A-Z]{5}[0-9]{4})|([A-Z]{4}[0-9]{5}))[A-Z]{1}[[1-9] [A-Z]]{1}[D Z]{1}[[A-Z][0-9]]{1}&quot;)
)</errorConditionFormula>
    <errorDisplayField>GST_Number__c</errorDisplayField>
    <errorMessage>Please enter correct GST Number.</errorMessage>
</ValidationRule>
