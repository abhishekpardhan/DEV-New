<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Opportunity_Validate_Quote</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISNEW(),
ISPICKVAL(Type__c, &quot;Existing-New&quot;),
NOT(Quote_To_be_sent__c)
)</errorConditionFormula>
    <errorMessage>&quot;Quote To Be Sent must be checked for adding a quote.&quot;</errorMessage>
</ValidationRule>
