<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Shipping_Pincode_Should_be_6_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(  Shipping_Zip_Postal_Code__c ),NOT(REGEX( Shipping_Zip_Postal_Code__c , &quot;\\d{6}&quot;)))</errorConditionFormula>
    <errorDisplayField>Shipping_Zip_Postal_Code__c</errorDisplayField>
    <errorMessage>Pickup Pin Code Should be 6 Digits.</errorMessage>
</ValidationRule>
