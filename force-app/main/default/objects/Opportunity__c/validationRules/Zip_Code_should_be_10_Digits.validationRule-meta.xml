<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Zip_Code_should_be_10_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(  Billing_Zip_Postal_Code__c ),NOT(REGEX( Billing_Zip_Postal_Code__c , &quot;\\d{6}&quot;)))</errorConditionFormula>
    <errorDisplayField>Billing_Zip_Postal_Code__c</errorDisplayField>
    <errorMessage>Billing Pin Code Should be 6 Digits</errorMessage>
</ValidationRule>
