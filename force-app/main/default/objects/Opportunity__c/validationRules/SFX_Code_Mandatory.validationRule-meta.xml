<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SFX_Code_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Customer_Type__c, &apos;Renewal Opportunity&apos;) ,ISBLANK (SFX_Code__c))</errorConditionFormula>
    <errorDisplayField>SFX_Code__c</errorDisplayField>
    <errorMessage>Please Fill SFX Account.</errorMessage>
</ValidationRule>
