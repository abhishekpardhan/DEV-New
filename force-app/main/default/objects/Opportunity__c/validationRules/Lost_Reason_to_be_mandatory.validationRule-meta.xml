<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_Reason_to_be_mandatory</fullName>
    <active>true</active>
    <description>Validation for creating loss reason  to be mandatory when stage is Closed Lost.</description>
    <errorConditionFormula>ISPICKVAL(  Stage__c , &apos;Closed Lost&apos;) &amp;&amp;   ISPICKVAL( Lost_Reason__c , &quot;&quot;)</errorConditionFormula>
    <errorDisplayField>Lost_Reason__c</errorDisplayField>
    <errorMessage>Lost Reason is mandatory.</errorMessage>
</ValidationRule>
