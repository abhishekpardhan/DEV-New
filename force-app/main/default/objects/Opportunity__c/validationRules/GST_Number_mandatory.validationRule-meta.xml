<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GST_Number_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Profile.Name != &apos;Integration User&apos;, ISPICKVAL(Stage__c ,&quot;Closed Won&quot;) ,ISBLANK(GST_Number__c),AND(!ISPICKVAL(Type__c ,&apos;Retail&apos;)),!Gst_Exempted__c)</errorConditionFormula>
    <errorDisplayField>GST_Number__c</errorDisplayField>
    <errorMessage>Please enter GST Number.</errorMessage>
</ValidationRule>
