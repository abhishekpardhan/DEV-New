<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_number_should_be_of_10_digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(Phone__c),NOT(REGEX(Phone__c, &quot;[1-9]{1}[0-9]{9}&quot;)))</errorConditionFormula>
    <errorDisplayField>Phone__c</errorDisplayField>
    <errorMessage>Phone number should be of 10 digits and must not start with 0</errorMessage>
</ValidationRule>
