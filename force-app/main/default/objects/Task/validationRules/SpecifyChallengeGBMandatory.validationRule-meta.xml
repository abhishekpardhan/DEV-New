<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SpecifyChallengeGBMandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Are_Payments_Received_in_GB__c, &quot;Yes&quot;),
ISBLANK(Specify_Challenges_GB__c)
)</errorConditionFormula>
