<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Submission_Completed_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(RecordType.Name= &apos;Submission&apos;, ISPICKVAL(Status,&apos;Completed&apos;),ISBLANK( Submitted_To__c ))</errorConditionFormula>
    <errorDisplayField>Submitted_To__c</errorDisplayField>
    <errorMessage>Please enter Submitted To to complete the task.</errorMessage>
</ValidationRule>
