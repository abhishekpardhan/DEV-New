<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ModeOfLastInteractionMandatory</fullName>
    <active>true</active>
    <errorConditionFormula>IF(RecordType.DeveloperName = &apos;Customer_Relationship_Profiling_Tasks&apos; &amp;&amp; ISPICKVAL( Mode_of_Last_Interaction__c ,&apos;&apos;) &amp;&amp; ISPICKVAL(Status,&apos;Completed&apos;) &amp;&amp;  NOT(ISPICKVAL(Current_Business_Status__c,&apos;Discontinued&apos;)) ,true,false)</errorConditionFormula>
    <errorDisplayField>Mode_of_Last_Interaction__c</errorDisplayField>
    <errorMessage>Mode Of Last Interaction is mandatory for completing the task.</errorMessage>
</ValidationRule>
