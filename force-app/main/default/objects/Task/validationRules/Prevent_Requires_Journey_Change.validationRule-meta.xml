<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Requires_Journey_Change</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    ISPICKVAL(PRIORVALUE(Status), &quot;Completed&quot;),
    ISCHANGED(Requires_Journey__c)
)</errorConditionFormula>
    <errorMessage>Requires Journey cannot be modified after the Task is completed.</errorMessage>
</ValidationRule>
