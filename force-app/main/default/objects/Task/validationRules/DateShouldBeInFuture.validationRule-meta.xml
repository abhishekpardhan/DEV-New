<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DateShouldBeInFuture</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Remaining_Payment_Tentative_Date__c &lt; TODAY(), NOT( $Profile.Name =&apos;Integration User&apos;),NOT($Profile.Name = &apos;Portfolio Management&apos;))</errorConditionFormula>
    <errorMessage>Payment Collective Date Should be in Future and Could not exceed the next month last date.</errorMessage>
</ValidationRule>
