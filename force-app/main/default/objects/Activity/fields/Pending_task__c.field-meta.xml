<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pending_task__c</fullName>
    <description>This Field is using for report to show submission task which is pending more then 15 days.</description>
    <externalId>false</externalId>
    <formula>if(RecordType.DeveloperName = &apos;Submission&apos; ,TODAY() - DATEVALUE(CreatedDate) ,0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Pending task</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
