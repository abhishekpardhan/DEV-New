<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Drop_Reason_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND((ISPICKVAL(Status__c  , &apos;Dropped&apos;)|| (ISPICKVAL(Status__c  , &apos;Dropped by Central desk&apos;))),ISPICKVAL(Lead_Drop_Reason__c, &apos;&apos;))</errorConditionFormula>
    <errorDisplayField>Lead_Drop_Reason__c</errorDisplayField>
    <errorMessage>Lead Drop Reason is required while dropping the lead.</errorMessage>
</ValidationRule>
