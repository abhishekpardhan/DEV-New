<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Zip_code_Should_be_6_Digist</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(  Zip_Postal_Code__c ),NOT(REGEX(Zip_Postal_Code__c , &quot;\\d{6}&quot;)))</errorConditionFormula>
    <errorDisplayField>Zip_Postal_Code__c</errorDisplayField>
    <errorMessage>Pin Code Should be 6 Digits</errorMessage>
</ValidationRule>
