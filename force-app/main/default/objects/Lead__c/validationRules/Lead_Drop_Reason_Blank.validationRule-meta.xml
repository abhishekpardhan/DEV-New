<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Drop_Reason_Blank</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Status__c  , &apos;Dropped&apos;)),NOT((ISPICKVAL(Lead_Drop_Reason__c, &apos;&apos;))))</errorConditionFormula>
    <errorDisplayField>Lead_Drop_Reason__c</errorDisplayField>
    <errorMessage>Lead drop reason must be blank/none if status is not dropped.</errorMessage>
</ValidationRule>
