<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Converted_status</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Automation__c  = False,IF(ISPICKVAL( Status__c ,&apos;Converted&apos;),true,false))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>You can&apos;t change the status to converted.</errorMessage>
</ValidationRule>
