<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campaign_name_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Source__c,&apos;Campaign&apos;), ISBLANK(Campaign__c))</errorConditionFormula>
    <errorDisplayField>Campaign_Name__c</errorDisplayField>
    <errorMessage>Please Fill Campaign Name.</errorMessage>
</ValidationRule>
