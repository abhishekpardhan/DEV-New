<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_date_future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Start_Date__c)) ,Start_Date__c &lt;TODAY())</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>Please fill future date.</errorMessage>
</ValidationRule>
