<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expire_On_after_end_date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(AND(OR(ISNEW(),ISCHANGED(Valid_Upto_for_Lead_Generation__c)),ADDMONTHS(Start_Date__c,3)&lt; Valid_Upto_for_Lead_Generation__c),Valid_Upto_for_Lead_Generation__c&lt;today()), ISPICKVAL(Status__c,&apos;Active&apos;))</errorConditionFormula>
    <errorDisplayField>Valid_Upto_for_Lead_Generation__c</errorDisplayField>
    <errorMessage>Valid Upto  should not be more than 90 days from start date and must be a future date</errorMessage>
</ValidationRule>
