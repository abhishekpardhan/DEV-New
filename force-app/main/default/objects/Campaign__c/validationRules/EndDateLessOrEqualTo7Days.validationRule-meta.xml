<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EndDateLessOrEqualTo7Days</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
End_Date__c &lt; Start_Date__c ,
End_Date__c &gt; (Start_Date__c + 7)
)</errorConditionFormula>
    <errorMessage>Campaign end date must be within 7 days or equal to 7 days from start date.</errorMessage>
</ValidationRule>
