<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW(),ISCHANGED( Account__c )),!ISBLANK(Account__c),ISBLANK( Contact__c ))</errorConditionFormula>
    <errorDisplayField>Contact__c</errorDisplayField>
    <errorMessage>Please fill Contact.</errorMessage>
</ValidationRule>
