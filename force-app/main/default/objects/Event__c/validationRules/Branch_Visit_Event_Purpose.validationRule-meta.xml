<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Branch_Visit_Event_Purpose</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(Name = &quot;System Event&quot;) , ISBLANK(Branch__c),ISPICKVAL(Event_Purpose__c , &apos;Branch Visit&apos;))</errorConditionFormula>
    <errorMessage>Branch Name to be tagged for Event Purpose:Branch Visit</errorMessage>
</ValidationRule>
