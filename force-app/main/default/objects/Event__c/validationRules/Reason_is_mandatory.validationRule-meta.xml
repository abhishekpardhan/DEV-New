<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_is_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Status__c)) ,ISPICKVAL(Status__c ,&apos;Cancelled&apos;) ,ISBLANK(TEXT( Reason__c )))</errorConditionFormula>
    <errorDisplayField>Reason__c</errorDisplayField>
    <errorMessage>Please fill Reason.</errorMessage>
</ValidationRule>
