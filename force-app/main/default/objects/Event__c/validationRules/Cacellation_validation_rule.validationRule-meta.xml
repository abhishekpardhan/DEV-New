<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cacellation_validation_rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISBLANK(CheckIn_Date__c), Cancel__c = True)</errorConditionFormula>
    <errorDisplayField>Cancel__c</errorDisplayField>
    <errorMessage>You cannot cancel this event, already Checked In</errorMessage>
</ValidationRule>
