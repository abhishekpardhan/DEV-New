<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_Date_future</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Start__c)) ,!is_Automated__c ,Start__c &lt; Now())</errorConditionFormula>
    <errorDisplayField>Start__c</errorDisplayField>
    <errorMessage>Please fill future Date.</errorMessage>
</ValidationRule>
