<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_cant_be_created</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(Journey__c)) ,!ISBLANK(Journey__c), !ISBLANK(Journey__r.CheckOut_Date__c))</errorConditionFormula>
    <errorMessage>Event can&apos;t be create against Closed Journey.</errorMessage>
</ValidationRule>
