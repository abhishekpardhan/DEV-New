<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Related_To_section_1_lookup_is_mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISBLANK(Campaign__c)  , ISBLANK( Account__c ) ,ISBLANK(Lead__c)  , ISBLANK( Opportunity__c ) ,ISBLANK(TEXT(Activity__c)) ,!is_Automated__c)</errorConditionFormula>
    <errorMessage>Please fill atleast One of them : Campaign,Account,Opportunity,Lead,Activity.</errorMessage>
</ValidationRule>
