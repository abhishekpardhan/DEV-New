<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Tan_No_Format_check</fullName>
    <active>true</active>
    <errorConditionFormula>AND( OR(ISNEW() ,ISCHANGED( TAN_No__c )) ,
!ISBLANK( TAN_No__c ) , 
!REGEX( TAN_No__c , &quot;[A-Z]{4}[0-9]{5}[A-Z]{1}&quot;) 
)</errorConditionFormula>
    <errorDisplayField>TAN_No__c</errorDisplayField>
    <errorMessage>Please enter correct TAN Number.</errorMessage>
</ValidationRule>
