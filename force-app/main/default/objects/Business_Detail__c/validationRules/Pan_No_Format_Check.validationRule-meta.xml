<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Pan_No_Format_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW() ,ISCHANGED(PAN_No__c)) ,!ISBLANK( PAN_No__c ) , !REGEX(PAN_No__c , &quot;[A-Z]{5}[0-9]{4}[A-Z]{1}&quot;))</errorConditionFormula>
    <errorDisplayField>PAN_No__c</errorDisplayField>
    <errorMessage>Please enter correct PAN number.</errorMessage>
</ValidationRule>
