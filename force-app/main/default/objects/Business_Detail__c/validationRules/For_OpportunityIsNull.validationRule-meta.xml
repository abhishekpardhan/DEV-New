<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>For_OpportunityIsNull</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISBLANK(Opportunity__c),
NOT(ISBLANK(Case__c)),
Case__r.Account__c &lt;&gt; Account__c
)</errorConditionFormula>
    <errorMessage>Case and Account mismatch.</errorMessage>
</ValidationRule>
