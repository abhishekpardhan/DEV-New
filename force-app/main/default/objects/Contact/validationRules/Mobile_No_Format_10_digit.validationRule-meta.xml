<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mobile_No_Format_10_digit</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(MobilePhone)),
  NOT(REGEX(MobilePhone, &quot;^[0-9]{10}$&quot;))
)</errorConditionFormula>
    <errorDisplayField>MobilePhone</errorDisplayField>
    <errorMessage>Mobile Should be 10 digit.</errorMessage>
</ValidationRule>
