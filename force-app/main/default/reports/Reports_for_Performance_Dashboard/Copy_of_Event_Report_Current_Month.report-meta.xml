    <customDetailFormulas>
        <calculatedFormula>IF(
OR(
NOT(ISBLANK(Event__c.Account__c.Name)),
NOT(ISBLANK(Event__c.Lead__c.Name)),
NOT(ISBLANK(Event__c.Opportunity__c.Name)),
NOT(ISBLANK(Event__c.Contact__c.Name)),
