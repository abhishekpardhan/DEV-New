    <customDetailFormulas>
        <calculatedFormula>(
IF(
CONTAINS(Event__c.Time_Spent_Auto__c,&quot;h&quot;),
VALUE(
TRIM(
LEFT(
Event__c.Time_Spent_Auto__c,
FIND(&quot;h&quot;,Event__c.Time_Spent_Auto__c)-1
)
)
)*60,
0
)
)
+
(
IF(
CONTAINS(Event__c.Time_Spent_Auto__c,&quot;m&quot;),
VALUE(
TRIM(
MID(
Event__c.Time_Spent_Auto__c,
FIND(&quot;h&quot;,Event__c.Time_Spent_Auto__c)+1,
FIND(&quot;m&quot;,Event__c.Time_Spent_Auto__c)-FIND(&quot;h&quot;,Event__c.Time_Spent_Auto__c)-1
)
)
),
0
)
)</calculatedFormula>
        <dataType>Double</dataType>
