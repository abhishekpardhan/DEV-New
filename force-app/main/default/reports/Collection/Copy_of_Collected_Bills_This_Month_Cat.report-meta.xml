        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>P %</masterLabel>
        <scale>0</scale>
    </aggregates>
    <aggregates>
        <calculatedFormula>CDF2:SUM/RowCount</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA2</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Percent</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <field>CDF1</field>
    </columns>
    <columns>
        <field>WHAT_NAME</field>
    </columns>
    <columns>
        <field>Activity.Remaining_Payment_Tentative_Date__c</field>
    </columns>
    <currency>INR</currency>
    <customDetailFormulas>
        <calculatedFormula>
  IF(
    ABS(
      DATEVALUE(COMPLETED_DATE_TIME) - 
      Activity.Remaining_Payment_Tentative_Date__c
    ) &lt;= 4,
    1,
    0
  )</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF2</developerName>
        <label>Day</label>
        <scale>0</scale>
    </customDetailFormulas>
    <customDetailFormulas>
        <calculatedFormula>IF(
  ISBLANK(Activity.Remaining_Payment_Tentative_Date__c),
  &quot;Unplanned&quot;,
  IF(
    DATEVALUE(COMPLETED_DATE_TIME) &lt;
    Activity.Remaining_Payment_Tentative_Date__c - 4,
    &quot;Before Planned&quot;,
    IF(
      DATEVALUE(COMPLETED_DATE_TIME) &gt;
      Activity.Remaining_Payment_Tentative_Date__c + 4,
      &quot;After Planned&quot;,
      &quot;As Planned&quot;
    )
  )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>On Time</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>For CY 2026</description>
    <filter>
        <criteriaItems>
