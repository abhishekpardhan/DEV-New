    <description>Checking the status and submit the approval process.</description>
    <environments>Default</environments>
    <formulas>
        <name>isApprove</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR( ISNEW() ,ISCHANGED({!$Record.Status__c}))
  ,ISPICKVAL({!$Record.Status__c}, &apos;Dropped&apos;)
  ,NOT(ISPICKVAL({!$Record.Lead_Drop_Reason__c},&apos;&apos;))
  ,NOT(ISPICKVAL({!$Record.Type__c},&apos;Retail&apos;))
  ,IF(BEGINS({!$Record.OwnerId}, &apos;00G&apos;),true,NOT(ISBLANK({!$Record.Owner:User.ManagerId}))))</expression>
    </formulas>
    <formulas>
        <name>IsCreateOrUpdate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>isFTL</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  ISPICKVAL({!$Record.Status__c}, &apos;Dropped&apos;)
  ,(ISPICKVAL({!$Record.Lead_Drop_Reason__c},&apos;FTL Customer&apos;))
)</expression>
    </formulas>
    <formulas>
        <name>isStatusChangedToDropped</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!$Record.Status__c}, &quot;Dropped&quot;),
    NOT(
        ISPICKVAL({!$Record__Prior.Status__c}, &quot;Dropped&quot;)
    )
)</expression>
    </formulas>
