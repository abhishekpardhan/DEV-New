<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Revive_Lead</name>
        <label>Revive Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>LeadReviveController</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Revival_Result</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>leadIds</name>
            <value>
                <elementReference>recordId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>LeadReviveController</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>reviveResult</assignToReference>
            <name>output</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
