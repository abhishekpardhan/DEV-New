        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Check Success or Error</description>
        <name>Revival_Result</name>
        <label>Revival_Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Revive_Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>reviveResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead revived.</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Revive_Success_Screen</targetReference>
            </connector>
            <label>Success</label>
        </rules>
    </decisions>
    <environments>Default</environments>
