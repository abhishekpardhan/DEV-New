    <description>Called by the Agentforce Business Enquiry topic. Finds or creates the Contact by mobile number, creates a Business Enquiry (B2B) Support Case with status Completed linked to that Contact, and returns the case number.</description>
    <environments>Default</environments>
    <formulas>
        <description>True only when the phone number is exactly 10 digits</description>
        <name>checkValidPhone</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  REGEX({!varPhone}, &quot;[6-9][0-9]{9}&quot;),
  NOT(REGEX({!varPhone}, &quot;.*([0-9])\\1{6,}.*&quot;)),
  {!varPhone} &lt;&gt; &quot;9876543210&quot;,
  {!varPhone} &lt;&gt; &quot;6789012345&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fxIsValidName</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  LEN(TRIM({!varName})) &gt;= 2,
  LEN(TRIM({!varName})) &lt;= 80,
  REGEX(TRIM({!varName}), &quot;[A-Za-z][A-Za-z .&apos;-]*&quot;),
  REGEX(LOWER({!varName}), &quot;.*[aeiouy].*&quot;),
  NOT(REGEX(LOWER({!varName}), &quot;.*([a-z])\\1\\1.*&quot;)),
  NOT(REGEX(LOWER({!varName}), &quot;.*[bcdfghjklmnpqrstvwxz]{5,}.*&quot;)),
  NOT(OR(
    CONTAINS(LOWER({!varName}), &quot;asdf&quot;), CONTAINS(LOWER({!varName}), &quot;qwer&quot;),
    CONTAINS(LOWER({!varName}), &quot;zxcv&quot;), CONTAINS(LOWER({!varName}), &quot;hjkl&quot;),
    CONTAINS(LOWER({!varName}), &quot;abcde&quot;)
  )),
  NOT(OR(
    LOWER(TRIM({!varName})) = &quot;test&quot;, LOWER(TRIM({!varName})) = &quot;dummy&quot;,
    LOWER(TRIM({!varName})) = &quot;name&quot;, LOWER(TRIM({!varName})) = &quot;xyz&quot;,
    LOWER(TRIM({!varName})) = &quot;abc&quot;,  LOWER(TRIM({!varName})) = &quot;na&quot;
  ))
)</expression>
    </formulas>
