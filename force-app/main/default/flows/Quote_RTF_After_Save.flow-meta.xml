    <decisions>
        <description>Checking if the Flow is running on Create or Update</description>
        <name>CreateorUpdate</name>
        <label>CreateorUpdate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isCreate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isCreateOrUpdate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>isCreate</label>
        </rules>
        <rules>
            <name>isupdate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isCreateOrUpdate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update</targetReference>
            </connector>
            <label>isupdate</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checking for the active flow</description>
        <name>isFlowActive</name>
        <label>isFlowActive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OrgSettings.Is_active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateorUpdate</targetReference>
            </connector>
            <label>Active</label>
        </rules>
    </decisions>
    <decisions>
        <description>using a decision element to find if status on Quote is Sent To Customer or not</description>
        <name>Update</name>
        <label>Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sent_To_cusotmer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OrgSettings.Is_active__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sent to Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assighn_Last_Quote_Sent_Date</targetReference>
            </connector>
            <label>Sent To cusotmer</label>
        </rules>
        <rules>
            <name>if_not_sent_to_cusotmer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Sent to Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_if_Last_Quote_Sent_date_is_not_null</targetReference>
            </connector>
            <label>if not sent to cusotmer</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!$Flow.FaultMessage}, &apos;You can look up ExceptionCode&apos;),
  LEFT(
    {!$Flow.FaultMessage},
    FIND(&apos;You can look up ExceptionCode&apos;, {!$Flow.FaultMessage}) - 1
  ),
  $Flow.FaultMessage
)</expression>
    </formulas>
    <formulas>
        <name>isCreateOrUpdate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>TimeStamp</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  AND(
    ISPICKVAL($Record.Status__c, &quot;Sent to customer&quot;),
    OR(
      ISBLANK($Record__Prior.Id),                                      /* handles creates */
      NOT(ISPICKVAL($Record__Prior.Status__c, &quot;Sent to customer&quot;))     /* handles updates */
    ),
    ISBLANK($Record.Quote_Sent_Date__c)
  ),
  $Flow.CurrentDateTime,
  $Record.Quote_Sent_Date__c
)</expression>
    </formulas>
    <interviewLabel>Quote_RTF_After_Save {!$Flow.CurrentDateTime}</interviewLabel>
