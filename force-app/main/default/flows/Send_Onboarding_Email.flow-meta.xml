    <description>Send onboarding email and Task notification to the task assigned to in Slack</description>
    <environments>Default</environments>
    <formulas>
        <name>assigneefullName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.FirstName} &amp; &quot; &quot; &amp; {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>ccEmails</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT(ISBLANK({!get_assignee_s_manager.Email})),
    NOT(CONTAINS({!get_assignee_s_manager.Name}, {!$Label.SFX_MD_Name}))
  ),
  {!get_assignee_s_manager.Email},
  &quot;&quot;
)
&amp;
IF(
  AND(
    NOT(ISBLANK({!get_manager_s_Manager.Email})),
    NOT(CONTAINS({!get_manager_s_Manager.Name}, {!$Label.SFX_MD_Name}))
  ),
  IF(
    AND(
      NOT(ISBLANK({!get_assignee_s_manager.Email})),
      NOT(CONTAINS({!get_assignee_s_manager.Name}, {!$Label.SFX_MD_Name})) 
    ),
    &quot;,&quot; &amp; {!get_manager_s_Manager.Email},
    {!get_manager_s_Manager.Email}
  ),
  &quot;&quot;
)
&amp;
IF(
  NOT(ISBLANK({!GetLocalNam.BDMPropelI__r.Email})),
  IF(
    OR(
      AND(
        NOT(ISBLANK({!get_assignee_s_manager.Email})),
        NOT(CONTAINS({!get_assignee_s_manager.Name}, {!$Label.SFX_MD_Name}))
      ),
      AND(
        NOT(ISBLANK({!get_manager_s_Manager.Email})),
        NOT(CONTAINS({!get_manager_s_Manager.Name}, {!$Label.SFX_MD_Name}))
      )
    ),
    &quot;,&quot; &amp; {!GetLocalNam.BDMPropelI__r.Email},
    {!GetLocalNam.BDMPropelI__r.Email}
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>finalTable</name>
        <dataType>String</dataType>
        <expression>/* Row 1: Assignee */
IF(
    NOT(ISBLANK({!getAssignee.Name})),
    &quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; {!getAssignee.Name} &amp;
    &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp;
        IF(
            {!getAssignee.Profile.Id} = {!rmProfileId},
            &quot;Regional Manager&quot;,
            IF(
                {!getAssignee.Profile.Id} = {!amProfileId},
                &quot;Area Manager&quot;,
                &quot;Territory Manager&quot;
            )
        ) &amp;
    &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; {!getAssignee.MobilePhone} &amp;
    &quot;&lt;/td&gt;&lt;td&gt;&lt;a href=&apos;mailto:&quot; &amp; {!getAssignee.Email} &amp; &quot;&apos;&gt;&quot; &amp; {!getAssignee.Email} &amp; &quot;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&quot;,
    &quot;&quot;
)

/* If assignee is RM, stop here (no Row 2 or 3) */
&amp;
IF(
    {!getAssignee.Profile.Id} = {!rmProfileId},
    &quot;&quot;,

    /* Row 2: Assignee&apos;s Manager */
    IF(
        OR(
            ISBLANK({!get_assignee_s_manager.Name}),
            {!get_assignee_s_manager.Name} = {!$Label.SFX_MD_Name}
        ),
        &quot;&quot;,
        &quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; {!get_assignee_s_manager.Name} &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp;
            IF(
                {!getAssignee.Profile.Id} = {!amProfileId},
                &quot;Regional Manager&quot;,
                &quot;Area Manager&quot;
            ) &amp;
        &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; {!get_assignee_s_manager.MobilePhone} &amp;
        &quot;&lt;/td&gt;&lt;td&gt;&lt;a href=&apos;mailto:&quot; &amp; {!get_assignee_s_manager.Email} &amp; &quot;&apos;&gt;&quot; &amp; {!get_assignee_s_manager.Email} &amp; &quot;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&quot;
    )
)

/* Row 3: Manager’s Manager — show only when present and assignee is not AM/RM */
&amp;
IF(
    OR(
        ISBLANK({!get_manager_s_Manager.Name}),
        {!get_manager_s_Manager.Name} = {!$Label.SFX_MD_Name},
        {!getAssignee.Profile.Id} = {!amProfileId},
        {!getAssignee.Profile.Id} = {!rmProfileId}
    ),
    &quot;&quot;,
    &quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; {!get_manager_s_Manager.Name} &amp; &quot;&lt;/td&gt;&lt;td&gt;Regional Manager&lt;/td&gt;&lt;td&gt;&quot; &amp;
        {!get_manager_s_Manager.MobilePhone} &amp;
    &quot;&lt;/td&gt;&lt;td&gt;&lt;a href=&apos;mailto:&quot; &amp; {!get_manager_s_Manager.Email} &amp; &quot;&apos;&gt;&quot; &amp; {!get_manager_s_Manager.Email} &amp; &quot;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>getDesignation</name>
        <dataType>String</dataType>
        <expression>IF(
    {!getAssignee.Profile.Id} = {!rmProfileId},
    &quot;Regional Manager&quot;,
    IF(
        {!getAssignee.Profile.Id} = {!amProfileId},
        &quot;Area Manager&quot;,
        &quot;Territory Manager&quot;
    )
)</expression>
    </formulas>
    <formulas>
        <name>nameWithoutCode</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!assigneefullName}, &quot;-&quot;),
  LEFT({!assigneefullName}, FIND(&quot;-&quot;, {!assigneefullName}) - 1),
  {!assigneefullName}
)</expression>
    </formulas>
