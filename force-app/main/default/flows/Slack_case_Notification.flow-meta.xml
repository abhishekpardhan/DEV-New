        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Is_Case_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecipientIDs</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Slack_Salesforce_User_Map</targetReference>
            </connector>
            <label>Outcome 1 of Is Case Assigned</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Slack_User</name>
