    <environments>Default</environments>
    <formulas>
        <name>checkFinance</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(ISNEW(),ISCHANGED({!$Record.Stage__c})),
ISPICKVAL({!$Record.Stage__c} , &apos;Closed Won&apos;),
OR
(ISPICKVAL({!$Record.Customer_Type__c}, &apos;New Opportunity&apos;),
ISPICKVAL({!$Record.Customer_Type__c}, &apos;Existing-New&apos;)),
!ISPICKVAL({!$Record.Type__c} ,&apos;Retail&apos;),
!ISPICKVAL({!$Record.Type__c} ,&apos;PRC&apos;))</expression>
    </formulas>
    <formulas>
        <name>checkPRC</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(ISNEW(),ISCHANGED({!$Record.Stage__c})),
ISPICKVAL({!$Record.Stage__c} , &apos;Closed Won&apos;),
OR
(ISPICKVAL({!$Record.Customer_Type__c} , &apos;New Opportunity&apos;),
ISPICKVAL({!$Record.Customer_Type__c} , &apos;Existing-New&apos;)),
ISPICKVAL({!$Record.Type__c} ,&apos;PRC&apos;))</expression>
    </formulas>
    <formulas>
        <name>checkQRM</name>
        <dataType>Boolean</dataType>
        <expression>AND(!ISBLANK({!$Record.Qrm_Email__c}) ,OR(ISNEW(),ISCHANGED({!$Record.Stage__c})) ,ISPICKVAL({!$Record.Stage__c} , &apos;Closed Won&apos;),ISPICKVAL({!$Record.Customer_Type__c} , &apos;Renewal Opportunity&apos;))</expression>
    </formulas>
    <formulas>
        <name>checkRetail</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(ISNEW(),ISCHANGED({!$Record.Stage__c})),
ISPICKVAL({!$Record.Stage__c} , &apos;Closed Won&apos;),
OR
(ISPICKVAL({!$Record.Customer_Type__c} , &apos;New Opportunity&apos;),
ISPICKVAL({!$Record.Customer_Type__c} , &apos;Existing-New&apos;)),
ISPICKVAL({!$Record.Type__c} ,&apos;Retail&apos;))</expression>
    </formulas>
