    <formulas>
        <name>fCompanyDiffers</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!fPortalCompany})),
  UPPER(TRIM({!get_Lead.Company})) &lt;&gt; UPPER(TRIM({!fPortalCompany}))
)</expression>
    </formulas>
    <formulas>
        <name>fGstin</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!GSTNumber}))</expression>
    </formulas>
    <formulas>
        <name>fGstStateCode</name>
        <dataType>String</dataType>
        <expression>LEFT({!fGstin}, 2)</expression>
    </formulas>
    <formulas>
        <name>fLoopStateMatches</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  UPPER(TRIM({!Loop_State_Codes.State_Abbreviation__c})) = {!fState},
  UPPER(TRIM({!Loop_State_Codes.MasterLabel})) = {!fState}
)</expression>
    </formulas>
    <formulas>
        <name>fNextStateNames</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varGstStateName}), {!Loop_State_Codes.MasterLabel}, {!varGstStateName} &amp; &quot; / &quot; &amp; {!Loop_State_Codes.MasterLabel})</expression>
    </formulas>
    <formulas>
        <name>fPan</name>
        <dataType>String</dataType>
        <expression>MID({!fGstin}, 3, 10)</expression>
    </formulas>
    <formulas>
        <name>fPortalCompany</name>
        <dataType>String</dataType>
        <expression>{!Call_GST_Portal.2XX.data.TradeName}</expression>
    </formulas>
    <formulas>
        <name>fState</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!StateInput}))</expression>
    </formulas>
    <formulas>
        <name>fStateToSave</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varMatchedStateCode}), TRIM({!StateInput}), {!varMatchedStateCode})</expression>
    </formulas>
